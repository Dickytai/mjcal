#!/usr/bin/env node
/**
 * Mahjong Tile Efficiency Wrapper v04
 * 優化版：Multiset分配 + 智能聽牌檢測
 */

const { tilesToHand, RuleSet } = require('mahjong-tile-efficiency');

const args = process.argv.slice(2);
const command = args[0];

// 34種牌
const TILES = [
    '1m','2m','3m','4m','5m','6m','7m','8m','9m',
    '1s','2s','3s','4s','5s','6s','7s','8s','9s',
    '1p','2p','3p','4p','5p','6p','7p','8p','9p',
    '1z','2z','3z','4z','5z','6z','7z'
];

const TILE_MAP = {
    '萬': 'm', '索': 's', '筒': 'p',
    '東': '1z', '南': '2z', '西': '3z', '北': '4z',
    '中': '5z', '發': '6z', '白': '7z'
};

// 預先轉換所有牌
function preprocessTiles(tiles) {
    const counts = new Array(34).fill(0);
    let wildcardCount = 0;
    
    for (const t of tiles) {
        if (t === '皇') {
            wildcardCount++;
        } else {
            const converted = convertTile(t);
            const idx = TILES.indexOf(converted);
            if (idx >= 0) counts[idx]++;
        }
    }
    
    return { counts, wildcardCount };
}

function convertTile(tile) {
    for (const [s, l] of Object.entries(TILE_MAP)) {
        if (tile.endsWith(s)) return tile.replace(s, '') + l;
    }
    return tile;
}

// Multiset分配：將k張皇分配到34種牌
function* generateDistributions(counts, wildcardCount) {
    if (wildcardCount === 0) {
        yield counts;
        return;
    }
    
    // 遞迴分配
    function* distribute(tileIndex, remaining, current) {
        if (tileIndex >= 34) {
            if (remaining === 0) yield [...current];
            return;
        }
        
        const maxAdd = Math.min(remaining, 4 - current[tileIndex]);
        
        for (let i = 0; i <= maxAdd; i++) {
            current[tileIndex] += i;
            yield* distribute(tileIndex + 1, remaining - i, current);
            current[tileIndex] -= i;
        }
    }
    
    yield* distribute(0, wildcardCount, [...counts]);
}

// 計算shanten (快速版)
function quickShanten(counts) {
    try {
        // 轉為tiles array
        const tiles = [];
        for (let i = 0; i < 34; i++) {
            for (let j = 0; j < counts[i]; j++) {
                tiles.push(TILES[i]);
            }
        }
        
        const hand = tilesToHand(tiles);
        const rule = new RuleSet('Taiwan');
        return rule.calShanten(hand);
    } catch (e) {
        return 999;
    }
}

// 計算ukeire (完整版)
function calcUkeire(counts) {
    try {
        const tiles = [];
        for (let i = 0; i < 34; i++) {
            for (let j = 0; j < counts[i]; j++) {
                tiles.push(TILES[i]);
            }
        }
        
        const hand = tilesToHand(tiles);
        const rule = new RuleSet('Taiwan');
        return rule.calUkeire(hand);
    } catch (e) {
        return null;
    }
}

// 計算某distribution既min shanten (快速版，用generateDistributions)
function getMinShanten(counts, wildcardCount) {
    if (wildcardCount === 0) {
        return quickShanten(counts);
    }
    
    let minS = 999;
    for (const c of generateDistributions(counts, wildcardCount)) {
        const s = quickShanten(c);
        if (s < minS) {
            minS = s;
            if (minS === 0) break;
        }
    }
    return minS;
}

// 測試加入一張牌後既min shanten (優化使用皇)
function testWaitingTile(baseCounts, baseWildcards, testTileIdx) {
    const testCounts = [...baseCounts];
    testCounts[testTileIdx]++;
    // 牌數變成17張，但皇既數量唔變
    
    return getMinShanten(testCounts, baseWildcards);
}

// 完整既waiting計算：考慮晒所有可能性
function calculateWaiting(counts, wildcardCount) {
    const waitingMap = {};
    
    // 首先睇下唔同牌既情況
    for (let i = 0; i < 34; i++) {
        // 檢查呢張牌既可用數量 (最多4張)
        const currentCount = counts[i];
        if (currentCount >= 4) continue;
        
        // 模擬加入呢張牌 (17張)
        const testCounts = [...counts];
        testCounts[i]++;
        
        // 搵最優既shanten
        const minS = getMinShanten(testCounts, wildcardCount);
        
        // 如果 minS = -1 代表completes the hand (胡牌)
        // 如果 minS = 0 代表tenpai (聽牌)
        // 我地要搵既係加入呢張牌可以聽牌既情況
        if (minS <= 0) {
            const tile = TILES[i];
            const maxCount = 4 - currentCount;
            waitingMap[tile] = maxCount;
        }
    }
    
    return waitingMap;
}

if (command === 'waiting') {
    const tiles = JSON.parse(args[1]);
    const { counts, wildcardCount } = preprocessTiles(tiles);
    
    // 檢查牌數
    const total = tiles.length;
    if (total !== 13 && total !== 16) {
        console.log(JSON.stringify({
            shanten: -1,
            waiting: [],
            error: `需要13或16張牌，目前有${total}張`
        }));
        process.exit(0);
    }
    
    // 過多皇直接報錯
    if (wildcardCount > 5) {
        console.log(JSON.stringify({
            shanten: -1,
            waiting: [],
            error: `皇牌數量過多(${wildcardCount}隻)，無法計算`
        }));
        process.exit(0);
    }
    
    // 找最小shanten
    let minShanten = getMinShanten(counts, wildcardCount);
    
    // 如果已經聽牌(shanten=0)，用之前既邏輯
    if (minShanten === 0) {
        // 用新既方法：測試加入邊張牌可以completes
        const waitingMap = calculateWaiting(counts, wildcardCount);
        const waiting = Object.keys(waitingMap).map(t => ({
            tile: t,
            count: waitingMap[t]
        }));
        
        console.log(JSON.stringify({ shanten: 0, waiting }));
        process.exit(0);
    }
    
    // 如果未聽牌(shanten > 0)，用逐張測試既方法
    // 測試加入邊張牌可以令shanten變為0
    const waitingMap = {};
    
    for (let i = 0; i < 34; i++) {
        // 檢查呢張牌既可用數量
        const currentCount = counts[i];
        if (currentCount >= 4) continue; // 最多4張
        
        const newShanten = testWaitingTile(counts, wildcardCount, i);
        
        // 如果加入呢張牌可以讓shanten變為0 (即聽牌)
        if (newShanten === 0) {
            const tile = TILES[i];
            const maxCount = 4 - currentCount;
            waitingMap[tile] = maxCount;
        }
    }
    
    const waiting = Object.keys(waitingMap).map(t => ({
        tile: t,
        count: waitingMap[t]
    }));
    
    console.log(JSON.stringify({ shanten: minShanten, waiting }));
}
