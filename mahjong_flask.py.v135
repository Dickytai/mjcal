@app.route('/calc', methods=['POST'])
# ===== 計算API =====
def calc():
    data = request.json
    hand = data.get('hand', [])
    open_tiles = data.get('open', [])
    mode = data.get('mode', 16)
    fan_config = data.get('fan_config', {})  # Fan config from frontend
    is_zimo = data.get('is_zimo', False)  # 自摸
    print(f"DEBUG: is_zimo={is_zimo}, type={type(is_zimo)}")
    
    # 合併手牌 + 公開牌 一齊計算
    all_tiles = hand + open_tiles
    expected = len(all_tiles)
    
    # Pass open tiles count and hand tiles for 明/暗 detection
    open_count = len(open_tiles)
    # Pass hand/open tiles via environment variables
    hand_json = json.dumps(hand)
    open_json = json.dumps(open_tiles)

    try:
        env = os.environ.copy()
        # Save fan_config to temp file
        import tempfile
        fan_config_path = tempfile.mktemp(suffix='.json')
        with open(fan_config_path, 'w') as f:
            json.dump(fan_config, f)
        
        env['HAND_TILES'] = hand_json
        env['OPEN_TILES'] = open_json
        env['FAN_CONFIG_PATH'] = fan_config_path
        is_zimo_str = '1' if is_zimo else '0'
        print(f"DEBUG: is_zimo={is_zimo}, is_zimo_str={is_zimo_str}")
        
        result = subprocess.run(
            ['node', '/home/tai/mjcal/mj_calc.js', 'full', json.dumps(all_tiles), str(expected), str(mode), '0', '0', '0', is_zimo_str, '0', '0', '0', str(open_count)],
            capture_output=True, text=True, timeout=10, env=env
        )

        if result.returncode != 0:
            # Error occurred in node - return validation error
            try:
                error_data = json.loads(result.stdout)
                return jsonify({'error': error_data.get('error', 'Error'), 'invalid': error_data.get('invalid', [])}), 400
            except:
                return jsonify({'error': 'Validation error'}), 400
        
        if result.returncode == 0:
            if False and result.stderr:
                print("STDERR:", result.stderr, file=sys.stderr)
                print("STDERR:", result.stderr, file=sys.stderr)
            node_result = json.loads(result.stdout)
            
            # Check for validation errors in result
            if node_result.get('error'):
                return jsonify({'error': node_result.get('error'), 'invalid': node_result.get('invalid', [])}), 400
            
            shanten = node_result.get('shanten', 0)
            
            # Winning hand info
            winning_fan = 0
            winning_breakdown = []
            winning_combinations = []  # New: multiple combinations
            
            if shanten == -1:
                waiting_with_fan = node_result.get('waiting_with_fan', [])
                for wf in waiting_with_fan:
                    if wf.get('tile') == '胡牌':
                        winning_fan = wf.get('fan', 0)
                        winning_breakdown = wf.get('breakdown', [])
                        break
                
                # Get multiple combinations using enumerateMelds
                try:
                    combo_result = subprocess.run(
                        ['node', '/home/tai/mjcal/mj_calc.js', 'test_multi', json.dumps(hand), json.dumps(open_tiles), str(len(open_tiles))],
                        capture_output=True, text=True, timeout=10, cwd='/home/tai/mjcal'
                    )
                    if combo_result.returncode == 0:
                        combo_data = json.loads(combo_result.stdout)
                        winning_combinations = combo_data.get('results', [])
                except:
                    pass
            
            # Waiting tiles with fan info
            waiting_tiles = node_result.get('waiting', [])
            waiting_with_fan = node_result.get('waiting_with_fan', [])

            waiting = []
            for wt in waiting_tiles:
                tile_code = wt.get('tile', '')
                fan_info = next((w for w in waiting_with_fan if w.get('tile') == tile_code), {})
                waiting.append({
                    'tile': tile_code,
                    'unicode': _TILE_CACHE.get(tile_code, '?'),
                    'count': wt.get('count', 1),
                    'fan': fan_info.get('fan', 1),
                    'breakdown': fan_info.get('breakdown', [])
                })

            return jsonify({
                'shanten': shanten, 
                'waiting': waiting, 
                'winning_fan': winning_fan, 
                'winning_breakdown': winning_breakdown,
                'winning_combinations': winning_combinations  # New: multiple combinations
            })
        else:
            return jsonify({'shanten': -1, 'waiting': [], 'winning_fan': 0, 'winning_breakdown': []})
    except Exception as e:
        import traceback
        print('ERROR:', str(e), file=sys.stderr)
        traceback.print_exc(file=sys.stderr)
        return jsonify({'shanten': -1, 'waiting': [], 'winning_fan': 0, 'winning_breakdown': []})

@app.route('/generate', methods=['GET'])
# ===== 生成牌 =====
def generate():
    """Generate a valid 17-tile winning hand"""
    import random
    
    # Strategy: Keep generating until we get a winning hand
    for _ in range(500):
        hand = []
        counts = [0] * 34
        
        # Generate 5 melds
        for _ in range(5):
            # Try chow first
            chows = []
            for suit in range(3):
                for start in range(7):
                    i0 = suit * 9 + start
                    # Check all 3 tiles have < 4 copies
                    if counts[i0] < 4 and counts[i0+1] < 4 and counts[i0+2] < 4:
                        chows.append([i0, i0+1, i0+2])
            
            if chows and random.random() > 0.3:
                meld = random.choice(chows)
            else:
                # Try pong - only tiles with < 3 copies
                pongs = [i for i in range(34) if counts[i] < 3]
                if not pongs:
                    break
                meld = [random.choice(pongs)] * 3
            
            # Verify adding this meld won't exceed 4
            valid = True
            for idx in meld:
                if counts[idx] + meld.count(idx) > 4:
                    valid = False
                    break
            if not valid:
                continue
                
            hand.extend(meld)
            for idx in meld:
                counts[idx] += 1
        
        if len(hand) != 15:
            continue
            
        # Generate pair - only tiles with < 2 copies
        pairs = [i for i in range(34) if counts[i] < 2]
        if not pairs:
            continue
        pair = [random.choice(pairs)] * 2
        hand.extend(pair)
        counts[pair[0]] += 2
        
        # Convert to tile names
        suits = ['m', 's', 'p', 'z']
        tiles = []
        for idx in hand:
            suit_idx = idx // 9  # 0-2 for m,s,p, 3 for z
            num = idx % 9 + 1
            if suit_idx >= 3:
                # Z (winds/dragon): 27->1z, 28->2z, etc
                tiles.append(str(idx - 27 + 1) + 'z')
            else:
                tiles.append(str(num) + suits[suit_idx])
        
        # Validate with mj_calc.js
        try:
            result = subprocess.run(
                ['node', '/home/tai/mjcal/mj_calc.js', 'full', json.dumps(tiles), '17'],
                capture_output=True, text=True, timeout=10
            )
            if result.returncode == 0:
                node_result = json.loads(result.stdout)
                if node_result.get('shanten', 0) == -1:
                    # Sort tiles
                    def tile_sort(t):
                        suit_order = {'m': 0, 's': 1, 'p': 2, 'z': 3}
                        s = t[-1]
                        n = int(t[:-1])
                        return (suit_order.get(s, 3), n)
                    tiles.sort(key=tile_sort)
                    return jsonify({'hand': tiles})
        except:
            pass
    
    return jsonify({'error': 'Failed to generate winning hand'})

# ========== Pattern Examples API ==========
import os
import sys
from datetime import datetime

EXAMPLES_FILE = '/home/tai/mjcal/pattern_examples.json'

# ===== 範例載入 =====
def load_examples():
    """Load pattern examples from file"""
    if os.path.exists(EXAMPLES_FILE):
        try:
            with open(EXAMPLES_FILE, 'r') as f:
                return json.load(f)
        except:
            return {}
    return {}

# ===== 範例保存 =====
def save_examples(examples):
    """Save pattern examples to file"""
    with open(EXAMPLES_FILE, 'w') as f:
        json.dump(examples, f, indent=2)

@app.route('/save_example', methods=['POST'])
# ===== 保存範例 =====
def save_example():
    """Save a pattern example"""
    data = request.json
    pattern = data.get('pattern', '')
    open_tiles = data.get('open_tiles', [])
    hand_tiles = data.get('hand_tiles', [])
    is_zimo = data.get('is_zimo', False)
    
    if not pattern or (not open_tiles and not hand_tiles):
        return jsonify({'error': 'Invalid data'}), 400
    
    examples = load_examples()
    
    if pattern not in examples:
        examples[pattern] = []
    
    examples[pattern].append({
        'open_tiles': open_tiles,
        'hand_tiles': hand_tiles,
        'is_zimo': is_zimo,
        'time': datetime.now().isoformat()
    })
    
    save_examples(examples)
    
    return jsonify({'success': True, 'count': len(examples[pattern])})


@app.route('/clear_examples', methods=['POST'])
# ===== 清除範例 =====
def clear_examples():
    """Clear all pattern examples"""
    save_examples({})
    return jsonify({'success': True})

# Test endpoint for multiple combinations (Phase 4)
@app.route('/test_multi_combo', methods=['POST'])
# ===== 測試多組合 =====
def test_multi_combo():
    """Test multiple combinations for a hand"""
    data = request.get_json()
    tiles = data.get('hand', [])
    
    if not tiles:
        return jsonify({'error': 'No tiles provided'})
    
    # Run Node.js test script
    import subprocess
    result = subprocess.run(
        ['node', '/home/tai/mjcal/mj_calc.js', 'test_multi', ','.join(tiles)],
        capture_output=True, text=True, cwd='/home/tai/mjcal'
    )
    
    return jsonify({
        'output': result.stdout,
        'error': result.stderr
    })

    

# ============================================================
# 番數配置 API
# ============================================================
import json
import os

FAN_CONFIG_FILE = '/home/tai/mjcal/fan_config.json'

def load_fan_config():
    try:
        with open(FAN_CONFIG_FILE, 'r', encoding='utf-8') as f:
            return json.load(f)
    except:
        return {"default": {"name": "預設", "patterns": {}}}

def save_fan_config(config):
    with open(FAN_CONFIG_FILE, 'w', encoding='utf-8') as f:
        json.dump(config, f, ensure_ascii=False, indent=2)

@app.route('/api/fan_config', methods=['GET'])
def get_fan_config():
    config = load_fan_config()
    return jsonify(config)

@app.route('/api/fan_config', methods=['POST'])
def update_fan_config():
    data = request.json
    config = load_fan_config()
    
    preset_name = data.get('name', '自訂')
    patterns = data.get('patterns', {})
    
    config[preset_name] = {
        "name": preset_name,
        "patterns": patterns
    }
    
    save_fan_config(config)
    return jsonify({"status": "ok", "message": "已保存: " + preset_name})

@app.route('/api/fan_presets', methods=['GET'])
def get_fan_presets():
    config = load_fan_config()
    presets = []
    for key, val in config.items():
        presets.append({"id": key, "name": val.get("name", key)})
    return jsonify(presets)

@app.route('/api/fan_preset/<preset_id>', methods=['GET'])
def get_fan_preset(preset_id):
    config = load_fan_config()
    if preset_id in config:
        return jsonify(config[preset_id])
    return jsonify({"error": "Preset not found"}), 404

@app.route('/api/fan_config_delete', methods=['POST'])
def delete_fan_preset():
    data = request.json
    preset_name = data.get('name', '')
    
    if not preset_name or preset_name == 'default':
        return jsonify({"status": "error", "message": "無法刪除預設番種"}), 400
    
    config = load_fan_config()
    if preset_name in config:
        del config[preset_name]
        save_fan_config(config)
        return jsonify({"status": "ok", "message": "已刪除: " + preset_name})
    return jsonify({"status": "error", "message": "番種不存在"}), 404


if __name__ == '__main__':
    print("🀄 麻將聽牌計算機 - http://192.168.1.88:5000")
    app.run(host='0.0.0.0', port=5000, debug=False)
