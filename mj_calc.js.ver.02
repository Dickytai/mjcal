#!/usr/bin/env node
/**
 * Mahjong Tile Efficiency Wrapper v02
 * 支援百搭牌 (皇) 既計算
 */

const { tilesToHand, RuleSet } = require('mahjong-tile-efficiency');

const args = process.argv.slice(2);
const command = args[0];

const ALL_TILES = [
    '1m','2m','3m','4m','5m','6m','7m','8m','9m',
    '1s','2s','3s','4s','5s','6s','7s','8s','9s',
    '1p','2p','3p','4p','5p','6p','7p','8p','9p',
    '1z','2z','3z','4z','5z','6z','7z'
];

const TILE_MAP = {
    '萬': 'm', '索': 's', '筒': 'p',
    '東': '1z', '南': '2z', '西': '3z', '北': '4z',
    '中': '5z', '發': '6z', '白': '7z'
};

function convertTile(tile) {
    for (const [s, l] of Object.entries(TILE_MAP)) {
        if (tile.endsWith(s)) return tile.replace(s, '') + l;
    }
    return tile;
}

function countWildcards(tiles) {
    return tiles.filter(t => t === '皇').length;
}

function getValidReplacements(tiles, wildcardCount) {
    const results = [];
    const wildcardIndices = [];
    
    tiles.forEach((t, i) => { if (t === '皇') wildcardIndices.push(i); });
    if (wildcardCount === 0) return [tiles];
    
    // Initial tile count
    const tileCount = {};
    tiles.forEach(t => {
        if (t !== '皇') {
            const c = convertTile(t);
            tileCount[c] = (tileCount[c] || 0) + 1;
        }
    });
    
    function generate(index, current) {
        if (index === wildcardCount) {
            results.push([...current]);
            return;
        }
        const pos = wildcardIndices[index];
        
        // Try each available tile that won't exceed 4 copies
        for (const tile of ALL_TILES) {
            if (!tileCount[tile] || tileCount[tile] < 4) {
                current[pos] = tile;
                tileCount[tile] = (tileCount[tile] || 0) + 1;
                generate(index + 1, current);
                tileCount[tile]--;
            }
        }
    }
    
    generate(0, [...tiles]);
    return results;
}

function calShanten(tiles) {
    try {
        const converted = tiles.map(convertTile);
        const hand = tilesToHand(converted);
        const rule = new RuleSet('Taiwan');
        return { shanten: rule.calShanten(hand), ukeire: rule.calUkeire(hand) };
    } catch (e) {
        return { shanten: 999, ukeire: {} };
    }
}

if (command === 'waiting') {
    const tiles = JSON.parse(args[1]);
    const wildcardCount = countWildcards(tiles);
    
    if (wildcardCount === 0) {
        const result = calShanten(tiles);
        if (result.shanten === 0 && result.ukeire.ukeire) {
            const waiting = Object.keys(result.ukeire.ukeire).map(t => ({tile: t, count: result.ukeire.ukeire[t]}));
            console.log(JSON.stringify({shanten: 0, waiting}));
        } else {
            console.log(JSON.stringify({shanten: result.shanten, waiting: []}));
        }
    } else {
        const replacements = getValidReplacements(tiles, wildcardCount);
        let best = {shanten: 999};
        
        for (const r of replacements) {
            const result = calShanten(r);
            if (result.shanten < best.shanten) {
                best = result;
            }
            if (result.shanten === 0) break;
        }
        
        if (best.shanten === 0 && best.ukeire.ukeire) {
            const waiting = Object.keys(best.ukeire.ukeire).map(t => ({tile: t, count: best.ukeire.ukeire[t]}));
            console.log(JSON.stringify({shanten: 0, waiting}));
        } else {
            console.log(JSON.stringify({shanten: best.shanten, waiting: []}));
        }
    }
}
