# ========================
# Routes
# ========================

@app.route('/')
def index():
    return render_template('index.html', 
                          tiles_json=TILES, 
                          flower_json=FLOWER_TILES, 
                          wildcards_json=WILDCARDS)

@app.route('/calc', methods=['POST'])
def calc():
    data = request.json
    hand = data.get('hand', [])
    open_tiles = data.get('open', [])
    mode = data.get('mode', 16)
    
    all_tiles = hand
    expected = len(hand)

    try:
        result = subprocess.run(
            ['node', '/home/tai/mjcal/mj_calc.js', 'full', json.dumps(all_tiles), str(expected)],
            capture_output=True, text=True, timeout=10
        )

        if result.returncode == 0:
            node_result = json.loads(result.stdout)
            shanten = node_result.get('shanten', 0)
            
            # Winning hand info
            winning_fan = 0
            winning_breakdown = []
            if shanten == -1:
                waiting_with_fan = node_result.get('waiting_with_fan', [])
                for wf in waiting_with_fan:
                    if wf.get('tile') == '胡牌':
                        winning_fan = wf.get('fan', 0)
                        winning_breakdown = wf.get('breakdown', [])
                        break
            
            # Waiting tiles with fan info
            waiting_tiles = node_result.get('waiting', [])
            waiting_with_fan = node_result.get('waiting_with_fan', [])

            waiting = []
            for wt in waiting_tiles:
                tile_code = wt.get('tile', '')
                fan_info = next((w for w in waiting_with_fan if w.get('tile') == tile_code), {})
                waiting.append({
                    'tile': tile_code,
                    'unicode': _TILE_CACHE.get(tile_code, '?'),
                    'count': wt.get('count', 1),
                    'fan': fan_info.get('fan', 1),
                    'breakdown': fan_info.get('breakdown', [])
                })

            return jsonify({
                'shanten': shanten, 
                'waiting': waiting, 
                'winning_fan': winning_fan, 
                'winning_breakdown': winning_breakdown
            })
        else:
            return jsonify({'shanten': -1, 'waiting': [], 'winning_fan': 0, 'winning_breakdown': []})
    except Exception as e:
        return jsonify({'shanten': -1, 'waiting': [], 'winning_fan': 0, 'winning_breakdown': []})

if __name__ == '__main__':
    print("🀄 麻將聽牌計算機 - http://192.168.1.88:5000")
    app.run(host='0.0.0.0', port=5000, debug=False)
