};

// ===== Debug模式 =====
function toggleDebugMode() {
    // false removed
    const panel = document.getElementById('debugPanel');
    const btn = document.getElementById('debugBtn');
    const saveBtn = document.getElementById('saveBtn');
    
    if (false) {
        panel.style.display = 'block';
        btn.classList.add('active');
        saveBtn.style.display = 'inline-block';
        populatePatternCheckboxes();
    } else {
        panel.style.display = 'none';
        btn.classList.remove('active');
        saveBtn.style.display = 'none';
    }
}

function populatePatternCheckboxes() {
    const container = document.getElementById('patternCheckboxes');
    container.innerHTML = '';
    
    for (const [category, patterns] of Object.entries(PATTERN_CATEGORIES)) {
        const fieldset = document.createElement('fieldset');
        fieldset.innerHTML = `<legend>${category}</legend>`;
        
        for (const p of patterns) {
            const label = document.createElement('label');
            label.className = 'checkbox-label';
            label.innerHTML = `<input type="checkbox" value="${p}" onchange="onCheckboxChange()"> ${p}`;
            fieldset.appendChild(label);
        }
        container.appendChild(fieldset);
    }
}

// Called when user changes any checkbox
function onCheckboxChange() {
    const checkboxes = document.querySelectorAll('#patternCheckboxes input[type="checkbox"]');
    const selected = [];
    checkboxes.forEach(cb => {
        if (cb.checked) selected.push(cb.value);
    });
    
    renderDisplayedPatterns(selected);
}

// Render patterns to display area
function renderDisplayedPatterns(patterns) {
    const detectedDiv = document.getElementById('detectedPatterns');
    if (patterns.length === 0) {
        detectedDiv.innerHTML = '<span class="no-pattern">無</span>';
    } else {
        detectedDiv.innerHTML = patterns.map(p => 
            `<span class="detected-tag" title="點擊移除" onclick="removePatternByName('${p}')">${p} ×</span>`
        ).join(' ');
    }
}

function removePatternByName(name) {
    const checkboxes = document.querySelectorAll('#patternCheckboxes input[type="checkbox"]');
    checkboxes.forEach(cb => {
        if (cb.value === name) cb.checked = false;
    });
    onCheckboxChange();
}

function filterPatterns(searchTerm) {
    const labels = document.querySelectorAll('#patternCheckboxes label');
    labels.forEach(label => {
        const text = label.textContent.toLowerCase();
        label.style.display = text.includes(searchTerm.toLowerCase()) ? "inline-block" : "none";
    });
}

// Update from server calculation
// ===== Pattern Detection UI =====
function updateDetectedPatterns(patterns) {
    const checkboxes = document.querySelectorAll('#patternCheckboxes input[type="checkbox"]');
    checkboxes.forEach(cb => {
        cb.checked = patterns.includes(cb.value);
    });
    onCheckboxChange();
}

function savePatternExample() {
    const allTiles = [...openTiles, ...handTiles];
    if (allTiles.length < 14) { alert('請輸入至少14張牌！'); return; }
    
    // Get currently checked patterns
    const checkboxes = document.querySelectorAll('#patternCheckboxes input[type="checkbox"]:checked');
    const selectedPatterns = Array.from(checkboxes).map(cb => cb.value);
    
    if (selectedPatterns.length === 0) { alert('請至少選擇一個牌型！'); return; }
    
    // Get self-draw status
    const isZimo = document.getElementById('zimoToggle').checked;
    
    // If self-draw, add "自摸" to patterns
    let patternsToSave = [...selectedPatterns];
    if (isZimo && !patternsToSave.includes('自摸')) {
        patternsToSave.push('自摸');
    }
    
    let saved = 0;
    patternsToSave.forEach(pattern => {
        fetch('/save_example', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                pattern: pattern, 
                open_tiles: openTiles,
                hand_tiles: handTiles,
                is_zimo: isZimo
            })
        }).then(r => r.json()).then(data => {
            saved++;
            if (saved === patternsToSave.length) alert(`已儲存 ${saved} 個牌型案例！`);
        });
    });
}

// ===== 計算劫持 =====
const originalCalculate = calculate;
calculate = function() {
    originalCalculate();
    if (false) {
        const allTiles = [...openTiles, ...handTiles];
        fetch('/calc', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({hand: allTiles, open: [], mode: 16})})
        .then(r => r.json()).then(result => {
            if (result.shanten === -1) updateDetectedPatterns(result.winning_breakdown.map(p => p.name));
            else updateDetectedPatterns([]);
        });
    }
};

init();

// Edit Fan Mode
let editFanMode = false;
let originalBreakdown = [];  // For cancel
let currentBreakdown = [];

// ===== 編輯番數 =====
function toggleEditFan() {
    editFanMode = !editFanMode;
    const btn = document.getElementById('editFanBtn');
    const grid = document.getElementById('waitingGrid');
    
    if (editFanMode) {
        // Save original breakdown for cancel
        originalBreakdown = currentBreakdown.map(b => ({name: b.name, fan: b.fan}));
        // button stays as is in edit mode
        grid.classList.add('edit-mode');
        renderEditFanUI();
    } else {
        btn.textContent = '✏️ 編輯番數';
        grid.classList.remove('edit-mode');
    }
}

function renderEditFanUI() {
    const grid = document.getElementById('waitingGrid');
    let html = '<div class="fan-list">';
    let total = 0;
    for (let i = 0; i < currentBreakdown.length; i++) {
        const b = currentBreakdown[i];
        total += b.fan;
        html += '<span class="fan-tag" onclick="deleteFan(' + i + ')">' + b.name + 
                '<input type="number" class="fan-num" value="' + b.fan + '" onclick="event.stopPropagation()" onchange="updateFan(' + i + ', this.value)"></span>';
    }
    html += '</div>';
    html += '<div style="margin-top:15px;padding-top:10px;border-top:1px solid #ccc;text-align:center;">';
    html += '<button onclick="showAddPattern()" style="padding:8px 16px;background:#3498db;color:#fff;border:none;border-radius:4px;cursor:pointer;margin:3px;">➕ 添加</button>';
    html += '<button onclick="saveEditFan()" style="padding:8px 16px;background:#27ae60;color:#fff;border:none;border-radius:4px;cursor:pointer;margin:3px;">✅ 完成&保存</button>';
    html += '<button onclick="cancelEditFan()" style="padding:8px 16px;background:#e74c3c;color:#fff;border:none;border-radius:4px;cursor:pointer;margin:3px;">取消修改</button>';
    html += '</div>';
    grid.innerHTML = html;
}

function deleteFan(index) {
    currentBreakdown.splice(index, 1);
    renderEditFanUI();
}

function updateFan(index, newFan) {
    currentBreakdown[index].fan = parseInt(newFan) || 0;
    let total = currentBreakdown.reduce((sum, b) => sum + b.fan, 0);
    document.getElementById('editTotalFan').textContent = total;
}


function saveEditFan() {
    editFanMode = false;
    document.getElementById('editFanBtn').textContent = '✏️ 編輯番數';
    document.getElementById('waitingGrid').classList.remove('edit-mode');
    const bdHtml = currentBreakdown.map(b => 
        '<span class="fan-tag">' + b.name + '<span class="fan-num">' + b.fan + '</span></span>'
    ).join('');
    document.getElementById('waitingGrid').innerHTML = '<div class="fan-list">' + bdHtml + '</div>';
}

// Default fan values for patterns
const DEFAULT_FAN = {
    "門清": 5, "不求人": 5, "自摸": 1, "場風": 1, "門風": 1, "花牌": 1, "平胡": 2, "碰碰胡": 6,
    "大三元": 30, "小三元": 20, "清一色": 30, "混一色": 15, "字一色": 30,
    "四暗刻": 50, "五暗刻": 80, "大四喜": 40, "小四喜": 30, "九連寶燈": 40,
    "副露": 0, "河底撈魚": 8, "海底撈月": 8, "搶槓": 8, "槓上花": 8,
    "七對子": 10, "全帶幺": 5, "斷幺": 5, "三色同順": 10, "三色同刻": 20,
    "一色二步高": 5, "一色三步高(明)": 10, "一色三步高(暗)": 20, "一色步步高": 10,
    "三色步步高(明)": 5, "三色步步高(暗)": 10, "三色二步高(明)": 3, "三色二步高(暗)": 5,
    "三色三步高(明)": 8, "三色三步高(暗)": 15,
    "對對胡": 6, "三暗刻": 5, "三槓": 15, "天胡": 50, "地胡": 30, "人胡": 20,
    "東風": 1, "南風": 1, "西風": 1, "北風": 1, "中": 1, "發": 1, "白": 1,
    "春": 1, "夏": 1, "秋": 1, "冬": 1, "梅": 1, "蘭": 1, "菊": 1, "竹": 1,
    "缺一門": 10, "老少": 3, "二相逢": 2, "三相逢": 10
};

function showAddPattern() {
    const allPatterns = [
        "門清","不求人","自摸","場風","門風","花牌","平胡","碰碰胡","大三元","小三元",
        "清一色","混一色","字一色","四暗刻","五暗刻","大四喜","小四喜","九連寶燈","副露",
        "河底撈魚","海底撈月","搶槓","槓上花","七對子","全帶幺","斷幺","三色同順","三色同刻",
        "一色二步高","一色三步高","一色步步高","三色步步高","三色二步高","三色三步高",
        "雜龍","對對胡","三暗刻","三槓","天胡","地胡","人胡","東風","南風","西風","北風",
        "中","發","白","春","夏","秋","冬","梅","蘭","菊","竹"
    ];
    const existing = currentBreakdown.map(b => b.name);
    const available = allPatterns.filter(p => !existing.includes(p));
    
    // Use dropdown instead of prompt, with onchange to auto-fill fan
    let html = '<select id="patternSelect" onchange="autoFillFan(this.value)" style="padding:5px;margin:5px;"><option value="">選擇牌型...</option>';
    available.forEach(p => {
        html += '<option value="' + p + '">' + p + '</option>';
    });
    html += '</select>';
    html += '<input type="number" id="fanNumInput" placeholder="番數" style="width:50px;padding:5px;">';
    html += '<button onclick="addPatternFromSelect()" style="padding:5px 10px;background:#3498db;color:#fff;border:none;border-radius:4px;">確認添加</button>';
    
    // Replace the button area temporarily
    document.getElementById('waitingGrid').innerHTML = '<div class="fan-list">' + 
        currentBreakdown.map((b, i) => '<span class="fan-tag" onclick="deleteFan(' + i + ')">' + b.name + 
        '<input type="number" class="fan-num" value="' + b.fan + '" onclick="event.stopPropagation()" onchange="updateFan(' + i + ', this.value)"></span>').join('') + 
        '</div><div style="margin-top:15px;text-align:center;">' + html + 
        '<button onclick="renderEditFanUI()" style="margin-left:10px;padding:5px 12px;background:#95a5a6;color:#fff;border:none;border-radius:4px;cursor:pointer;">返回</button></div>';
}

function autoFillFan(patternName) {
    const input = document.getElementById('fanNumInput');
    if (patternName && DEFAULT_FAN[patternName] !== undefined) {
        input.value = DEFAULT_FAN[patternName];
    }
}

function addPatternFromSelect() {
    const select = document.getElementById('patternSelect');
    const input = document.getElementById('fanNumInput');
    const name = select.value;
    const fan = parseInt(input.value);
    
    if (!name) {
        alert('請選擇牌型！');
        return;
    }
    if (isNaN(fan) || fan <= 0) {
        alert('請輸入有效番數！');
        return;
    }
    
    currentBreakdown.push({name: name, fan: fan});
    renderEditFanUI();
}

function cancelEditFan() {
    editFanMode = false;
    document.getElementById('editFanBtn').textContent = '✏️ 編輯番數';
    document.getElementById('waitingGrid').classList.remove('edit-mode');
    // Restore original breakdown (discard changes)
    currentBreakdown = originalBreakdown.map(b => ({name: b.name, fan: b.fan}));
    // Re-render original display
    const bdHtml = currentBreakdown.map(b => 
        '<span class="fan-tag">' + b.name + '<span class="fan-num">' + b.fan + '</span></span>'
    ).join('');
    document.getElementById('waitingGrid').innerHTML = '<div class="fan-list">' + bdHtml + '</div>';
}


// ===== 組合顯示 =====
function showCombo(idx) {
    var dataEl = document.getElementById('comboData');
    var displayEl = document.getElementById('comboDisplay');
    if (!dataEl || !displayEl) return;
    
    try {
        var combos = JSON.parse(dataEl.innerHTML);
        var combo = combos[idx];
        if (!combo || !combo.breakdown) return;
        
        var html = '<div class="fan-list">';
        for (var i = 0; i < combo.breakdown.length; i++) {
            var b = combo.breakdown[i];
            html = html + '<span class="fan-tag">' + b.name + '<span class="fan-num">' + b.fan + '</span></span>';
        }
        html = html + '</div>';
        displayEl.innerHTML = html;
    } catch(e) {}
}
</script>


<!-- Fan Settings Modal -->
<div class="modal" id="fanSettingsModal" style="display:none;">
    <div class="modal-content" style="max-width:800px; max-height:90vh; overflow-y:auto;">
        <span class="modal-close" onclick="closeFanSettings()">&times;</span>
        <h2 style="text-align:center; color:#333;">⚙️ 番數設定</h2>
        
        <div style="margin:15px 0; padding:10px; background:#f8f9fa; border-radius:8px;">
            <label style="font-weight:bold;">📁 選擇番種配置：</label>
            <select id="presetSelect" onchange="loadPreset()" style="padding:8px; margin-left:10px; border-radius:5px;">
                <option value="default">預設</option>
            </select>
            <button onclick="savePreset()" style="padding:8px 15px; margin-left:10px; background:#27ae60; color:#fff; border:none; border-radius:5px; cursor:pointer;">💾 保存當前</button>
        </div>
        
        <div id="fanSettingsContent" style="padding:10px;">
            <!-- Fan settings will be loaded here -->
        </div>
    </div>
</div>

<script>
// Fan Settings Functions
function showFanSettings() {
    loadPresetsList();
    document.getElementById('fanSettingsModal').style.display = 'block';
    loadFanSettings();
}

function closeFanSettings() {
    document.getElementById('fanSettingsModal').style.display = 'none';
}

function loadPresetsList() {
    fetch('/api/fan_presets')
        .then(r => r.json())
        .then(presets => {
            const select = document.getElementById('presetSelect');
            select.innerHTML = '';
            presets.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.id;
                opt.textContent = p.name;
                select.appendChild(opt);
            });
        });
}

function loadPreset() {
    const presetId = document.getElementById('presetSelect').value;
    fetch('/api/fan_preset/' + presetId)
        .then(r => r.json())
        .then(data => {
            displayFanSettings(data.patterns || {});
        });
}

function loadFanSettings() {
    fetch('/api/fan_config')
        .then(r => r.json())
        .then(config => {
            // Load first preset by default
            const firstKey = Object.keys(config)[0];
            if (firstKey) {
                displayFanSettings(config[firstKey].patterns || {});
            }
        });
}

function displayFanSettings(patterns) {
    const container = document.getElementById('fanSettingsContent');
    const categories = {
        "一色類": ["清一色", "混一色", "字一色"],
        "門齊類": ["大七門齊", "小七門齊", "七門齊", "五門齊"],
        "斷缺類": ["斷幺", "缺一門"],
        "門清類": ["門清"],
        "暗刻類": ["坎坎胡", "五暗刻", "四暗刻", "三暗刻", "對對胡"],
        "三元類": ["大三元", "小三元"],
        "風牌類": ["大四喜", "小四喜", "風字坎", "箭刻"],
        "般高類": ["三般高", "一般高"],
        "老少類": ["老少"],
        "步高類": ["一色五步高(明)", "一色五步高(暗)", "一色四步高(明)", "一色四步高(暗)", "一色三步高(明)", "一色三步高(暗)", "一色二步高(明)", "一色二步高(暗)", "一色步步高(明)", "一色步步高(暗)", "三色五步高(明)", "三色五步高(暗)", "三色四步高(明)", "三色四步高(暗)", "三色三步高(明)", "三色三步高(暗)", "三色二步高(明)", "三色二步高(暗)", "三色步步高(明)", "三色步步高(暗)"],
        "兄弟類": ["大三兄弟", "小三兄弟", "二兄弟"],
        "姊妹類": ["六姊妹", "五姊妹", "大三姊妹", "四姊妹", "三姊妹", "兩姊妹"],
        "相逢類": ["三相逢", "二相逢"],
        "同款類": ["同款七連對", "同款六連對", "同款五連對", "同款四連對", "同款三連對"],
        "同順類": ["五同順", "四同順"],
        "歸類": ["十二歸一(明)", "十二歸一(暗)", "十二歸四(明)", "八歸一(明)", "八歸一(暗)", "八歸四(明)", "四歸一(明)", "四歸一(暗)"],
        "么九類": ["清么九", "混么九"],
        "特殊牌型": ["不搭三相逢"],
        "槓類": ["四槓", "三槓", "二槓", "一槓"],
        "花牌類": ["正花", "無字花"],
        "特殊胡牌": ["海底撈月", "河底撈魚", "將眼", "自摸", "莊"],
        "額外番": ["天聽", "地聽", "人聽", "搶槓", "槓上花", "連莊", "爛風", "正風", "雙番"]
    };
    
    let html = '';
    for (const [cat, items] of Object.entries(categories)) {
        html += `<h3 style="color:#2c3e50; border-bottom:2px solid #3498db; padding:5px 0; margin-top:20px;">${cat}</h3>`;
        html += '<div style="display:flex; flex-wrap:wrap; gap:10px;">';
        for (const item of items) {
            const fan = patterns[item] || 0;
            html += `<div style="display:flex; align-items:center; background:#ecf0f1; padding:5px 10px; border-radius:5px;">
                <span style="min-width:120px;">${item}</span>
                <input type="number" class="fan-edit" data-pattern="${item}" value="${fan}" min="0" style="width:60px; padding:3px; text-align:center; margin-left:5px;">
                <span style="margin-left:5px;">番</span>
            </div>`;
        }
        html += '</div>';
    }
    
    container.innerHTML = html;
}

function savePreset() {
    // Collect all fan values
    const inputs = document.querySelectorAll('.fan-edit');
    const patterns = {};
    inputs.forEach(input => {
        patterns[input.dataset.pattern] = parseInt(input.value) || 0;
    });
    
    const presetName = prompt("請輸入番種名稱（例如：自訂、番種1）", "自訂");
    if (!presetName) return;
    
    fetch('/api/fan_config', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({name: presetName, patterns: patterns})
    })
    .then(r => r.json())
    .then(data => {
        alert('✅ ' + data.message);
        loadPresetsList();
        loadFanConfigFromServer();
    });
}
</script>
</body>
</html>
