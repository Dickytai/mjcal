               "三色二步高(明)", "三色二步高(暗)", "一色二步高(明)", "一色二步高(暗)",
               "三色三步高(明)", "三色三步高(暗)", "一色三步高(明)", "一色三步高(暗)",
               "三色四步高(明)", "三色四步高(暗)", "一色四步高(明)", "一色四步高(暗)",
               "三色五步高(明)", "三色五步高(暗)", "一色五步高(明)", "一色五步高(暗)"],
    
    // 老少類
    "老少類": ["老少", "老少刻"],
    
    // 對對胡
    "對對胡類": ["對對胡"],
    
    // 同刻類
    "同刻類": ["兄弟", "小三兄弟", "大三兄弟"],
    
    // 連刻類
    "連刻類": ["兩連刻", "小三連刻", "三連刻", "小四連刻", "四連刻", "小五連刻", "五連刻"],
    
    // 暗刻類
    "暗刻類": ["兩暗刻", "三暗刻", "四暗刻", "五暗刻", "坎坎胡"],
    
    // 槓類
    "槓類": ["搶槓", "一槓", "二槓", "三槓", "四槓", "五槓"],
    
    // 歸類
    "歸類": ["四歸一(明)", "四歸一(暗)", "四歸二(明)", "四歸二(暗)", "四歸四(明)", "四歸四(暗)"],
    
    // 風牌類
    "風牌類": ["小三風", "大三風", "小四喜", "大四喜"],
    
