let extraFanList = []; // Store selected extra fan items

function updateExtraFan() {
    extraFanList = [];
    
    for (const [id, item] of Object.entries(EXTRA_FAN_ITEMS)) {
        const checkbox = document.getElementById(id);
        if (checkbox && checkbox.checked) {
            extraFanList.push(item);
        }
    }
    
    // Update display if we're in edit mode or showing results
    renderExtraFanInBreakdown();
}

function renderExtraFanInBreakdown() {
    // Find the fan-list element
    const fanListEl = document.querySelector('.fan-list');
    if (!fanListEl) return;
    
    // Get current HTML
    let html = fanListEl.innerHTML;
    
    // Remove any existing extra fan tags first (but keep the original breakdown)
    // We'll rebuild from currentBreakdown + extra items
    const existingBreakdown = currentBreakdown || [];
    
    // Rebuild HTML with 自摸 + extra items (filter out 風字坎 if wind selected)
    html = '';
    
    // Check if 圈/位 selected
    const quanWind = document.getElementById('quan_wind').value;
    const weiWind = document.getElementById('wei_wind').value;
    const hasWindSelected = (quanWind || weiWind);
    
    // Add original breakdown items (remove 風字坎 if wind selected)
    let originalFanTotal = 0;
    for (const b of existingBreakdown) {
        if (hasWindSelected && b.name === '風字坎') continue;  // Skip 風字坎, will replace with new calculation
        html += '<span class="fan-tag">' + b.name + '<span class="fan-num">' + b.fan + '</span></span>';
        originalFanTotal += b.fan;
    }
    
    // Add 莊 if checkbox is checked
    const zhuangCheckbox = document.getElementById('chk_zhuang');
    const zhuangCount = parseInt(document.getElementById('zhuangCount').value) || 0;
    if (zhuangCheckbox && zhuangCheckbox.checked) {
        const zhuangFan = (2 * zhuangCount + 1);
        html += '<span class="fan-tag" data-extra="true">莊<span class="fan-num">' + zhuangFan + '</span></span>';
    }
    
    // Add 自摸 if checked
    const zimoCheckbox = document.getElementById('chk_zimo');
    if (zimoCheckbox && zimoCheckbox.checked) {
        html += '<span class="fan-tag" data-extra="true">自摸<span class="fan-num">1</span></span>';
    }
    
    // Add 風牌 items based on actual wind pongs in hand
    if (hasWindSelected) {
        const windCounts = { '東': 0, '南': 0, '西': 0, '北': 0 };
        for (const t of handTiles) {
            if (t === '1z') windCounts['東']++;
            if (t === '2z') windCounts['南']++;
            if (t === '3z') windCounts['西']++;
            if (t === '4z') windCounts['北']++;
        }
        
        for (const [wind, count] of Object.entries(windCounts)) {
            if (count >= 3) {  // Has pong
                let fengFan = 1;
                
                if (quanWind && weiWind) {
                    if (quanWind === wind && weiWind === wind) {
                        fengFan = 4;  // 雙番
                    } else if (quanWind === wind || weiWind === wind) {
                        fengFan = 2;  // 正風
                    }
                } else if (quanWind || weiWind) {
                    if (quanWind === wind || weiWind === wind) {
                        fengFan = 2;  // 正風
                    }
                }
                
                if (fengFan === 1) {
                    html += '<span class="fan-tag" data-extra="true">爛風' + wind + '<span class="fan-num">' + fengFan + '</span></span>';
                } else if (fengFan === 2) {
                    html += '<span class="fan-tag" data-extra="true">正風' + wind + '<span class="fan-num">' + fengFan + '</span></span>';
                } else if (fengFan === 4) {
                    html += '<span class="fan-tag" data-extra="true">雙番' + wind + '<span class="fan-num">' + fengFan + '</span></span>';
                }
            }
        }
    }
    
    // Add other extra fan items (海底撈月 etc)
    for (const item of extraFanList) {
        html += '<span class="fan-tag" data-extra="true">' + item.name + '<span class="fan-num">' + item.fan + '</span></span>';
    }
    
    fanListEl.innerHTML = html;
    
    // Update total fan display
    updateTotalFanWithExtra();
}

function updateTotalFanWithExtra() {
    // Calculate base fan from currentBreakdown
    let baseFan = 0;
    for (const b of currentBreakdown) {
        baseFan += b.fan;
    }
    
    // Add 自摸 if checked
    const zimoCheckbox = document.getElementById('chk_zimo');
    if (zimoCheckbox && zimoCheckbox.checked) {
        baseFan += 1;
    }
    
    // Add 風牌 fan based on actual wind pongs
    if (hasWindSelected) {
        const windCounts = { '東': 0, '南': 0, '西': 0, '北': 0 };
        for (const t of handTiles) {
            if (t === '1z') windCounts['東']++;
            if (t === '2z') windCounts['南']++;
            if (t === '3z') windCounts['西']++;
            if (t === '4z') windCounts['北']++;
        }
        
        for (const [wind, count] of Object.entries(windCounts)) {
            if (count >= 3) {
                let fengFan = 1;
                if (quanWind && weiWind) {
                    if (quanWind === wind && weiWind === wind) fengFan = 4;
                    else if (quanWind === wind || weiWind === wind) fengFan = 2;
                } else if (quanWind || weiWind) {
                    if (quanWind === wind || weiWind === wind) fengFan = 2;
                }
                extraFan += fengFan;
            }
        }
    }
    
    // Add other extra fan
    let extraFan = 0;
    for (const item of extraFanList) {
        extraFan += item.fan;
    }
    
    const totalFan = baseFan + extraFan;
    
    // Update the total display
    const shantenEl = document.getElementById('shantenResult');
    if (shantenEl && shantenEl.textContent.includes('總番數')) {
        shantenEl.textContent = '🀄 已胡牌！總番數: ' + totalFan + ' 番';
    }
}

function clearAll() {
    openTiles = [];
    handTiles = [];
    document.getElementById('resultSection').classList.remove('show');
    document.getElementById('extraInfoRow').style.display = 'none';
    document.getElementById('extraFanSection').style.display = 'none';
    
    // Reset extra info checkboxes
    document.getElementById('zhuangCount').value = 0;
    document.getElementById('chk_zimo').checked = false;
    document.getElementById('quan_wind').value = '';
    document.getElementById('wei_wind').value = '';
    
    // Reset extra fan checkboxes
    extraFanList = [];
    for (const id of Object.keys(EXTRA_FAN_ITEMS)) {
        const checkbox = document.getElementById(id);
        if (checkbox) checkbox.checked = false;
    }
    
    updateDisplay();
}

