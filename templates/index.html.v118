    "元牌類": ["小三元", "大三元"],
    
    // 求人類
    "求人類": ["門清", "不求人", "半求人", "全求人"],
    
    // 速度類
    "速度類": ["天胡", "地胡", "人胡", "四子", "七子", "十子"],
    
    // 嚦咕類
    "嚦咕類": ["嚦咕", "正嚦咕"],
    
    // 十六不搭類
    "十六不搭類": ["十六不搭", "十六不搭十六面聽", "十六不搭三相逢", "正十六不搭"],
    
    // 十三幺類
    "十三幺類": ["十三幺", "十三幺十三面聽"],
    
