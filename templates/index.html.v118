<!DOCTYPE html>
<html lang="zh-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>🀄 麻將聽牌計算機</title>
<link rel="stylesheet" href="/static/app.css">

<style>
#editFanBtn { display:block; margin:10px auto; padding:8px 16px; background:#4CAF50;color:#fff;border:none;border-radius:4px;cursor:pointer; }
#editFanBtn:hover { background:#45a049; }
.edit-mode .fan-tag { position:relative; padding-left:25px; display:inline-block; margin:5px; }
.edit-mode .fan-tag::before {
    content:'✕'; position:absolute; left:2px; top:50%; transform:translateY(-50%);
    color:red; cursor:pointer; font-weight:bold; font-size:14px;
}
.edit-mode .fan-num { 
    background:#fff; border:1px solid #999; padding:2px 6px; 
    min-width:30px; text-align:center; border-radius:3px;
}
#editTotalFan { font-weight:bold; color:#f39c12; font-size:18px; }
</style>
</head>
<body>
<h1>🀄 麻將聽牌計算機</h1>
    

<div class="mode-select">
    <button class="mode-btn active" id="mode16" data-mode="16">16張</button>

</div>

<!-- Debug Mode Panel -->
<div class="debug-panel" id="debugPanel" style="display:none;">
    <div class="debug-header">
        <h3>🔧 牌型測試模式</h3>
        <button onclick="toggleDebugMode()">關閉</button>
    </div>
    <div class="debug-content">
        <div class="debug-section">
            <label><strong>實際檢測 (即時)：</strong></label>
            <div class="detected-patterns" id="detectedPatterns"></div>
        </div>
        <div class="debug-section">
            <label><strong>修正組合 (勾選)：</strong></label>
            <input type="text" id="patternSearch" placeholder="搜尋..." onkeyup="filterPatterns(this.value)" style="width:100%;padding:8px;margin:5px 0;border:1px solid #e94560;border-radius:5px;background:#0f0f23;color:#fff;">
            <div class="pattern-checkboxes" id="patternCheckboxes"></div>
        </div>
    </div>
</div>

<div class="tile-count warning" id="tileCount">手牌: 0 | 公開牌: 0</div>

<div class="display-section">
    <div class="label active" id="openLabel">🔓 公開牌</div>
    <div class="tile-display" id="openDisplay"></div>
</div>

<div class="display-section">
    <div class="label" id="handLabel">🧱 手牌</div>
    <div class="tile-display" id="handDisplay"></div>
</div>

<div class="code-input">
    <div style="font-size:12px;color:#888;margin-bottom:4px;">代碼輸入框</div>
    <input type="text" id="codeInput" placeholder="例如: 1112223334567m 或 111m222m333m456m7m">
    <div class="hint">百搭: 1j=皇 2j=合 3j=萬 4j=筒 5j=索 6j=風 7j=番 8j=三元</div>
    <div class="btn-row">
        <button onclick="loadFromCode()">📥 載入代碼</button>
        <button onclick="generateWinningHand()" class="btn-gen">🎲 生成17張胡牌</button>
        <button onclick="calculate()" class="btn-calc">🔍 計算聽牌</button>
        <button onclick="clearAll()" class="btn-clear">🗑️ 清除</button>

        <button onclick="savePatternExample()" class="btn-save" id="saveBtn" style="display:none;">✅ 確認輸入牌型</button>
        <button onclick="showFanSettings()" class="btn-settings" style="background:#9b59b6;">⚙️ 番數設定</button>
    </div>
</div>

<p class="tip">提示：點擊上方「公開牌」或「手牌」可切換輸入模式</p>

<div class="tile-section"><h3>🀇 萬子</h3><div class="tile-grid" id="wanTiles"></div></div>
<div class="tile-section"><h3>🀐 索子</h3><div class="tile-grid" id="tiaoTiles"></div></div>
<div class="tile-section"><h3>🀙 筒子</h3><div class="tile-grid" id="tongTiles"></div></div>
<div class="tile-section"><h3>🀀 字牌</h3><div class="tile-grid" id="ziTiles"></div></div>
<div class="tile-section"><h3>🀢 花牌</h3><div class="tile-grid" id="flowerTiles"></div></div>
<div class="tile-section"><h3>🃏 百搭</h3><div class="tile-grid" id="wildTiles"></div></div>

<!-- Row 1: Extra Info - 莊/自摸/圈局 -->
<div id="extraInfoRow" style="display:none; margin:10px 0; padding:10px; background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius:10px; text-align:center; box-shadow:0 2px 8px rgba(0,0,0,0.2);">
    <div style="display:inline-flex; align-items:center; margin:0 10px; color:#fff; font-size:16px;">
        <label style="cursor:pointer; display:flex; align-items:center;">
            <input type="checkbox" id="chk_zhuang" onchange="updateExtraInfo()" style="transform:scale(1.3);">
            <b style="margin-left:5px;">🏠 莊</b>
        </label>
        <button onclick="changeZhuang(-1)" style="width:28px; height:28px; margin-left:10px; font-size:16px; cursor:pointer; border-radius:5px; border:none; background:#fff; color:#667eea;">-</button>
        <input type="number" id="zhuangCount" value="0" min="0" max="99" onchange="updateExtraInfo()" style="width:45px; text-align:center; margin:0 5px; padding:4px; border-radius:5px; border:none; font-weight:bold;">
        <button onclick="changeZhuang(1)" style="width:28px; height:28px; font-size:16px; cursor:pointer; border-radius:5px; border:none; background:#fff; color:#667eea;">+</button>
    </div>
    <label style="margin:0 15px; color:#fff; font-size:16px; cursor:pointer;"><input type="checkbox" id="chk_zimo" onchange="updateExtraInfo()" style="transform:scale(1.3);"> <b>✋ 自摸</b></label>
    <div style="display:inline-flex; align-items:center; margin-left:15px; color:#fff; font-size:14px;">
        <select id="quan_wind" onchange="updateExtraInfo()" style="padding:4px 8px; border-radius:5px; border:2px solid #fff; background:rgba(255,255,255,0.9); font-weight:bold; cursor:pointer;">
            <option value="">選擇圈</option>
            <option value="東">東圈</option>
            <option value="南">南圈</option>
            <option value="西">西圈</option>
            <option value="北">北圈</option>
        </select>
        <span style="margin:0 3px;">圈</span>
        <select id="wei_wind" onchange="updateExtraInfo()" style="padding:4px 8px; border-radius:5px; border:2px solid #fff; background:rgba(255,255,255,0.9); font-weight:bold; cursor:pointer;">
            <option value="">選擇位</option>
            <option value="東">東位</option>
            <option value="南">南位</option>
            <option value="西">西位</option>
            <option value="北">北位</option>
        </select>
        <span style="margin:0 3px;">位</span>
    </div>
</div>

<!-- Row 2: 追加番數 Section (expandable) -->
<div id="extraFanSection" style="display:none; margin:10px 0; padding:12px; background:#fff; border:2px solid #4caf50; border-radius:10px; box-shadow:0 2px 6px rgba(0,0,0,0.1);">
    <div onclick="toggleExtraFan()" style="cursor:pointer; font-weight:bold; color:#2e7d32; font-size:16px; display:flex; justify-content:space-between; align-items:center;">
        <span>🎯 追加番數</span>
        <span id="extraFanToggleIcon">▼</span>
    </div>
    <div id="extraFanContent" style="display:none; margin-top:12px; padding-top:10px; border-top:1px dashed #4caf50;">
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_haidi" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🌊 海底撈月 <b style="color:#e74c3c;">10番</b></label>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_heidi" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🐟 河底撈魚 <b style="color:#e74c3c;">20番</b></label>

        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_qianggang" onchange="updateExtraFan()" style="transform:scale(1.2);"> ⚡ 搶槓 <b style="color:#e74c3c;">8番</b></label>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_gangshang" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🎴 槓上花 <b style="color:#e74c3c;">8番</b></label>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_lianzhuang" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🔄 連莊 <b style="color:#e74c3c;">1番</b></label>
        <br><span style="color:#666;font-size:12px;">=== 特殊胡牌 ===</span>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_tianhu" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🌟 天胡 <b style="color:#e74c3c;">50番</b></label>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_dihu" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🌍 地胡 <b style="color:#e74c3c;">30番</b></label>
        <br><span style="color:#666;font-size:12px;">=== 聽牌類 ===</span>

        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_tingpaijishi" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🎯 聽牌即食 <b style="color:#e74c3c;">2番</b></label>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_tingpai" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🎯 聽牌 <b style="color:#e74c3c;">1番</b></label>
        <br><span style="color:#666;font-size:12px;">=== 搶槓類 ===</span>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_yiqiangqi" onchange="updateExtraFan()" style="transform:scale(1.2);"> ⚡ 一搶七 <b style="color:#e74c3c;">8番</b></label>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_qiqiangyi" onchange="updateExtraFan()" style="transform:scale(1.2);"> ⚡ 七搶一 <b style="color:#e74c3c;">10番</b></label>
        <br><span style="color:#666;font-size:12px;">=== 自摸類 ===</span>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_huashangzimo" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🌸 花上自摸 <b style="color:#e74c3c;">8番</b></label>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_gangshangzimo" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🎴 槓上自摸 <b style="color:#e74c3c;">8番</b></label>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_gangshanggangzimo" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🎴 槓上槓自摸 <b style="color:#e74c3c;">16番</b></label>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_tingpaijishi" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🎯 聽牌即食 <b style="color:#e74c3c;">2番</b></label>
        <br><span style="color:#666;font-size:12px;">=== 內子類 ===</span>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_sizinei" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🔢 四只內 <b style="color:#e74c3c;">20番</b></label>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_qizinei" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🔢 七只內 <b style="color:#e74c3c;">30番</b></label>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_shizinei" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🔢 十只內 <b style="color:#e74c3c;">40番</b></label>
        <br><span style="color:#666;font-size:12px;">=== 響類 ===</span>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_shuangxiang" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🔔 雙響 <b style="color:#e74c3c;">5番</b></label>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_sanxiang" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🔔 三響 <b style="color:#e74c3c;">10番</b></label>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_shuangxiangbaochou" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🔔 雙響報仇 <b style="color:#e74c3c;">10番</b></label>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_sanxiangbaochou" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🔔 三響報仇 <b style="color:#e74c3c;">20番</b></label>
        <br><span style="color:#666;font-size:12px;">=== 聽牌 ===</span>
        <label style="display:inline-block; margin:5px 12px; color:#333; cursor:pointer;"><input type="checkbox" id="chk_tingpai" onchange="updateExtraFan()" style="transform:scale(1.2);"> 🎯 聽牌 <b style="color:#e74c3c;">1番</b></label>
    </div>
</div>

<!-- Row 3: 結果顯示區 -->
<div class="result-section" id="resultSection">
    <div class="result-box">
        <div class="shanten" id="shantenResult"></div>
        <button id="editFanBtn" onclick="toggleEditFan()" style="display:none;">✏️ 編輯番數</button>
        <div class="waiting-grid" id="waitingGrid"></div>
    </div>
</div>

<!-- Custom Modal -->
<div class="modal" id="modal">
    <div class="modal-content">
        <span class="modal-close" onclick="closeModal()">&times;</span>
        <div id="modalBody"></div>
    </div>
</div>

<script>
// ===== 常量/全局變量 =====
const TILES = {{ tiles_json | tojson | safe }};
const FLOWER_TILES = {{ flower_json | tojson | safe }};
const WILDCARDS = {{ wildcards_json | tojson | safe }};

// State
let gameMode = 16;
let openTiles = [];
let handTiles = [];
let inputMode = 'open';

// Initialize
// ===== 初始化 =====
function init() {
    renderButtons();
    bindEvents();
    setInputMode('open');
}

// Bind events
function bindEvents() {
    document.getElementById('openDisplay').addEventListener('click', () => setInputMode('open'));
    document.getElementById('handDisplay').addEventListener('click', () => setInputMode('hand'));
    document.querySelectorAll('.mode-btn').forEach(btn => {
        btn.addEventListener('click', (e) => setMode(parseInt(e.target.dataset.mode)));
    });
}

// Render tile buttons
function renderButtons() {
    const suits = [
        { id: 'wanTiles', key: 'wan', tiles: ['1m','2m','3m','4m','5m','6m','7m','8m','9m'] },
        { id: 'tiaoTiles', key: 'tiao', tiles: ['1s','2s','3s','4s','5s','6s','7s','8s','9s'] },
        { id: 'tongTiles', key: 'tong', tiles: ['1p','2p','3p','4p','5p','6p','7p','8p','9p'] },
        { id: 'ziTiles', key: 'zi', tiles: ['1z','2z','3z','4z','5z','6z','7z'] },
    ];

    suits.forEach(s => {
        const container = document.getElementById(s.id);
        s.tiles.forEach(tile => {
            const btn = document.createElement('button');
            btn.className = 'tile-btn ' + s.key;
            btn.textContent = TILES[tile]?.unicode || '?';
            btn.onclick = () => addTile(tile);
            container.appendChild(btn);
        });
    });

    // Flower tiles
    const flowerContainer = document.getElementById('flowerTiles');
    Object.keys(FLOWER_TILES).forEach(tile => {
        const btn = document.createElement('button');
        btn.className = 'tile-btn flower';
        btn.textContent = FLOWER_TILES[tile].unicode;
        btn.onclick = () => addTile(tile);
        flowerContainer.appendChild(btn);
    });

    // Wildcards
    const wildContainer = document.getElementById('wildTiles');
    Object.keys(WILDCARDS).forEach(key => {
        const w = WILDCARDS[key];
        const btn = document.createElement('button');
        btn.className = 'tile-btn wild';
        btn.textContent = w.unicode;
        btn.title = w.name + ': ' + w.替代;
        btn.onclick = () => addTile(w.code);
        wildContainer.appendChild(btn);
    });
}

// Add tile
// ===== 牌管理 =====
function addTile(tile) {
    // Check if it's a flower tile
    const isFlower = FLOWER_TILES && FLOWER_TILES[tile] !== undefined;
    
    // Flower tiles can only be added to open area
    if (isFlower && inputMode !== 'open') {
        alert('花牌只能放入公開區！');
        return;
    }
    
    const arr = inputMode === 'open' ? openTiles : handTiles;
    const counts = {};
    arr.forEach(t => counts[t] = (counts[t] || 0) + 1);

    // Flower tiles can only have 1 copy
    if (isFlower && (counts[tile] || 0) >= 1) {
        alert('花牌每款只能1張！');
        return;
    }
    
    // Non-flower tiles max 4 copies
    if (!isFlower && (counts[tile] || 0) >= 4) {
        alert('每張牌最多4張！');
        return;
    }

    if (inputMode === 'open') {
        if (openTiles.length >= 16) {
            alert('公開牌最多16張！');
            return;
        }
        openTiles.push(tile);
    } else {
        if (handTiles.length >= 17) {
            alert('手牌最多17張！');
            return;
        }
        handTiles.push(tile);
    }
    updateDisplay();
}

// Remove tile
function removeTile(arr, index) {
    arr.splice(index, 1);
    updateDisplay();
}

// Update display
function updateDisplay() {
    document.getElementById('tileCount').textContent = '手牌: ' + handTiles.length + ' | 公開牌: ' + openTiles.length;

    const od = document.getElementById('openDisplay');
    od.innerHTML = '';
    openTiles.forEach((t, i) => {
        const d = createTileDiv(t);
        d.onclick = () => removeTile(openTiles, i);
        od.appendChild(d);
    });

    const hd = document.getElementById('handDisplay');
    hd.innerHTML = '';
    handTiles.forEach((t, i) => {
        const d = createTileDiv(t);
        d.onclick = () => removeTile(handTiles, i);
        hd.appendChild(d);
    });
}

// Create tile div
function createTileDiv(tile) {
    const d = document.createElement('div');
    let c = 'tile ';
    if (TILES[tile]) c += TILES[tile].suit;
    else if (FLOWER_TILES[tile]) c += FLOWER_TILES[tile].suit;
    else if (tile.endsWith('j')) c += 'wild';
    d.className = c;
    
    // Get display text
    let text = tile;
    if (TILES[tile]) text = TILES[tile].unicode;
    else if (FLOWER_TILES[tile]) text = FLOWER_TILES[tile].unicode;
    else if (tile.endsWith('j')) {
        // Map code to name (matching backend code)
        const map = {'1j':'🃏皇','2j':'合','3j':'萬','4j':'筒','5j':'索','6j':'風','7j':'番','8j':'三元'};
        text = map[tile] || tile;
    }
    
    d.innerHTML = text + '<span class="remove">×</span>';
    return d;
}

// Set input mode
// ===== 模式/輸入 =====
function setInputMode(mode) {
    inputMode = mode;
    document.getElementById('openLabel').classList.toggle('active', mode === 'open');
    document.getElementById('handLabel').classList.toggle('active', mode === 'hand');
    document.getElementById('openDisplay').classList.toggle('active', mode === 'open');
    document.getElementById('handDisplay').classList.toggle('active', mode === 'hand');
}

// Set game mode
function setMode(mode) {
    gameMode = mode;
    document.querySelectorAll('.mode-btn').forEach(btn => {
        btn.classList.toggle('active', parseInt(btn.dataset.mode) === mode);
    });
}

// Load from code
function loadFromCode() {
    const code = document.getElementById('codeInput').value.trim();
    if (!code) { alert('請輸入牌代碼'); return; }

    handTiles = [];
    openTiles = [];

    const tokens = code.match(/[0-9]+[mpsznj]/g) || [];
    tokens.forEach(token => {
        const num = token.slice(0, -1);
        const suit = token.slice(-1);
        const actualSuit = suit === 'j' ? 'z' : suit;
        for (let i = 0; i < num.length; i++) {
            const tile = num[i] + actualSuit;
            if (TILES[tile]) handTiles.push(tile);
        }
    });

    updateDisplay();
    calculate();
}

// Generate winning hand
// Generate winning hand - use backend API for 100% success
// ===== 遊戲邏輯 =====
function generateWinningHand() {
    fetch('/generate')
        .then(r => r.json())
        .then(data => {
            if (data.hand) {
                handTiles = data.hand;
                openTiles = [];
                
                // Display the tile codes in the input field
                const allTilesStr = handTiles.join(' ');
                document.getElementById('codeInput').value = allTilesStr;
                
                updateDisplay();
                // Trigger calculation and update detected patterns
                if (false) {
                    calculate();
                } else {
                    setTimeout(calculate, 100);
                }
            } else {
                alert('生成失敗，請再試');
            }
        })
        .catch(e => {
            showModal('Error: ' + e.message);
        });
}

function idxToTile(idx) {
    if (idx === undefined || idx === null || isNaN(idx) || idx < 0 || idx >= 34) return '';
    const suits = ['m', 's', 'p'];
    const suit = Math.floor(idx / 9);
    const num = idx % 9;
    return (num + 1) + suits[suit];
}

// Calculate
// ===== 計算 =====
function calculate() {
    if (handTiles.length === 0) {
        alert('請先選擇手牌！');
        return;
    }
    fetch('/calc', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ hand: handTiles, open: openTiles, mode: gameMode })
    }).then(r => r.json()).then(showResult);
}

// Show result
function showResult(d) {
    const s = document.getElementById('resultSection');
    s.classList.add('show');

    let shantenText = '';
    let shantenClass = '';

    // Show extra info row and extra fan section for winning hands
    if (d.shanten === -1) {
        document.getElementById('extraInfoRow').style.display = 'block';
        document.getElementById('extraFanSection').style.display = 'block';
    } else {
        document.getElementById('extraInfoRow').style.display = 'none';
        document.getElementById('extraFanSection').style.display = 'none';
    }
    
    if (d.shanten === -1) {
        const totalFan = d.winning_fan || 0;
        // Add extra fan items to breakdown
        let breakdown = (d.winning_breakdown || []).slice();
        for (const item of extraFanList) {
            breakdown.push({ name: item.name, fan: item.fan });
        }
        // Sort by fan descending
        breakdown.sort((a, b) => b.fan - a.fan);
        shantenText = '🀄 已胡牌！總番數: ' + totalFan + ' 番';
        shantenClass = ' tenpai';

        // Display winning combinations
        var combinations = d.winning_combinations || [];
        
        if (breakdown.length > 0) {
            var html = '';
            
            // Deduplicate combinations (same breakdown = same combo)
            var uniqueCombos = [];
            var seenBreakdowns = {};
            for (var i = 0; i < combinations.length; i++) {
                var bd = combinations[i].breakdown || [];
                var key = bd.map(function(b) { return b.name + ':' + b.fan; }).sort().join('|');
                if (!seenBreakdowns[key]) {
                    seenBreakdowns[key] = true;
                    uniqueCombos.push(combinations[i]);
                }
            }
            
            // If multiple valid combinations, show dropdown
            if (uniqueCombos.length > 1) {
                // Sort by fan (highest first)
                var sorted = uniqueCombos.slice().sort(function(a, b) { return b.fan - a.fan; });
                
                // Build dropdown
                html = html + '<div style="margin-bottom:10px;">';
                html = html + '<select id="comboSelect" onchange="showCombo(this.value)" style="padding:8px;width:100%;">';
                
                for (var i = 0; i < sorted.length; i++) {
                    var fan = sorted[i].fan || 0;
                    html = html + '<option value="' + i + '">組合' + (i+1) + ' (' + fan + '番)</option>';
                }
                
                html = html + '</select></div>';
                html = html + '<div id="comboDisplay">';
                html = html + '</div>';
                
                // Store for switching
                html = html + '<div style="display:none;" id="comboData">' + JSON.stringify(sorted) + '</div>';
                
                document.getElementById('waitingGrid').innerHTML = html;
                
                // Show first (highest fan) combo
                showCombo(0);
                
                // Also set currentBreakdown for edit mode
                currentBreakdown = sorted[0].breakdown.slice().sort(function(a, b) { return b.fan - a.fan; });
                
                document.getElementById('editFanBtn').style.display = 'block';
            } else {
                // Single combination or no combinations - use original breakdown
                currentBreakdown = breakdown.slice().sort(function(a, b) { return b.fan - a.fan; });
                var bdHtml = '';
                for (var i = 0; i < currentBreakdown.length; i++) {
                    bdHtml = bdHtml + '<span class="fan-tag">' + currentBreakdown[i].name + '<span class="fan-num">' + currentBreakdown[i].fan + '</span></span>';
                }
                html = '<div class="fan-list">' + bdHtml + '</div>';
                document.getElementById('waitingGrid').innerHTML = html;
                document.getElementById('editFanBtn').style.display = 'block';
            }
        } else {
            document.getElementById('editFanBtn').style.display = 'none';
        }
    } else if (d.shanten === 0) {
        shantenText = '🎉 已聽牌!';
        shantenClass = ' tenpai';
    } else if (d.shanten > 0) {
        shantenText = '向聽數: ' + d.shanten;
    } else {
        shantenText = '❌ 未能聽牌';
    }

    document.getElementById('shantenResult').textContent = shantenText;
    document.getElementById('shantenResult').className = 'shanten' + shantenClass;

    const g = document.getElementById('waitingGrid');
    // Show extra info row and extra fan section for winning hands
    if (d.shanten === -1) {
        document.getElementById('extraInfoRow').style.display = 'block';
        document.getElementById('extraFanSection').style.display = 'block';
    } else {
        document.getElementById('extraInfoRow').style.display = 'none';
        document.getElementById('extraFanSection').style.display = 'none';
    }
    
    if (d.shanten === -1) {
        // Winning - breakdown shown above
    } else if (d.waiting.length === 0) {
        g.innerHTML = '<div style="color:#aaa;font-size:14px">暫無聽牌</div>';
    } else {
        const suits = { 'wan': [], 'tiao': [], 'tong': [], 'zi': [] };
        d.waiting.forEach(w => {
            const t = w.tile;
            if (t.endsWith('m')) suits.wan.push(w);
            else if (t.endsWith('s')) suits.tiao.push(w);
            else if (t.endsWith('p')) suits.tong.push(w);
            else suits.zi.push(w);
        });

        let html = '';
        Object.keys(suits).forEach(suit => {
            if (suits[suit].length === 0) return;
            html += '<div style="display:flex;gap:6px;justify-content:center;margin:5px 0;flex-wrap:wrap;">';
            suits[suit].forEach(w => {
                html += '<div class="waiting-item ' + suit + '" onclick="showBreakdown(\'' + w.tile + '\', \'' + w.unicode + '\', ' + JSON.stringify(w.breakdown).replace(/"/g, '&quot;') + ', ' + w.fan + ')">';
                html += '<span class="tc">' + w.unicode + '</span>';
                html += '<span class="fan">' + w.fan + '番</span>';
                html += '</div>';
            });
            html += '</div>';
        });
        g.innerHTML = html;
    }

    s.scrollIntoView({ behavior: 'smooth' });
}

// ===== 結果顯示 =====
function showBreakdown(tile, unicode, breakdown, fan) {
    if (breakdown && breakdown.length > 0) {
        const msg = breakdown.map(b => b.name + ': ' + b.fan + '番').join('\n');
        showModal('胡 ' + unicode + ' 的牌型:\n' + msg + '\n\n總番數: ' + fan + '番');
    } else {
        showModal('胡 ' + unicode + ': ' + fan + '番');
    }
}

// ===== 彈窗 =====
function showModal(content) {
    document.getElementById('modalBody').innerHTML = content.replace(/\n/g, '<br>');
    document.getElementById('modal').classList.add('show');
}

function closeModal() {
    document.getElementById('modal').classList.remove('show');
}

// ===== 清除 =====
// Change zhuang count
function changeZhuang(delta) {
    const input = document.getElementById('zhuangCount');
    let val = parseInt(input.value) || 0;
    val += delta;
    if (val < 0) val = 0;
    if (val > 99) val = 99;
    input.value = val;
    updateExtraInfo();
}

// Extra info: 莊, 自摸, 圈局
function updateExtraInfo() {
    let zhuangCount = parseInt(document.getElementById('zhuangCount').value) || 0;
    const zimo = document.getElementById('chk_zimo') ? document.getElementById('chk_zimo').checked : false;
    const quanWind = document.getElementById('quan_wind').value;
    const weiWind = document.getElementById('wei_wind').value;
    const hasWindSelected = (quanWind || weiWind);
    
    // Update the shanten result text
    const shantenEl = document.getElementById('shantenResult');
    if (shantenEl && shantenEl.textContent.includes('已胡牌')) {
        // Recalculate total
        // Calculate base fan, excluding 風字坎 if wind is selected
        let baseFan = 0;
        for (const b of (currentBreakdown || [])) {
            if (hasWindSelected && b.name === '風字坎') continue;  // Don't count 風字坎, will add new wind fan
            baseFan += b.fan;
        }
        
        let extra = 0;
        // 莊 fan is now shown as separate item, not added here
        if (zimo) extra += 1;
        
        const total = baseFan + extra;
        
        // Build info string (without 莊, it's in breakdown)
        let info = [];
        if (zimo) info.push('自摸');
        if (quanWind && weiWind) info.push(quanWind + '圈' + weiWind + '位');
        else if (quanWind) info.push(quanWind + '圈');
        else if (weiWind) info.push(weiWind + '位');
        
        const infoStr = info.length > 0 ? ' (' + info.join('/') + ')' : '';
        shantenEl.textContent = '🀄 已胡牌！總番數: ' + total + ' 番' + infoStr;
        
        // Update breakdown to show 自摸
        renderExtraFanInBreakdown();
    }
}

function toggleExtraFan() {
    const content = document.getElementById('extraFanContent');
    const icon = document.getElementById('extraFanToggleIcon');
    if (content.style.display === 'none') {
        content.style.display = 'block';
        icon.textContent = '▲';
    } else {
        content.style.display = 'none';
        icon.textContent = '▼';
    }
}

