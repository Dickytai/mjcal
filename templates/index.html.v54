<!DOCTYPE html>
<html lang="zh-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>🀄 麻將聽牌計算機</title>
<link rel="stylesheet" href="/static/app.css">
</head>
<body>
<h1>🀄 麻將聽牌計算機</h1>

<div class="mode-select">
    <button class="mode-btn active" id="mode16" data-mode="16">16張</button>

</div>

<!-- Debug Mode Panel -->
<div class="debug-panel" id="debugPanel" style="display:none;">
    <div class="debug-header">
        <h3>🔧 牌型測試模式</h3>
        <button onclick="toggleDebugMode()">關閉</button>
    </div>
    <div class="debug-content">
        <div class="debug-section">
            <label><strong>實際檢測 (即時)：</strong></label>
            <div class="detected-patterns" id="detectedPatterns"></div>
        </div>
        <div class="debug-section">
            <label><strong>修正組合 (勾選)：</strong></label>
            <input type="text" id="patternSearch" placeholder="搜尋..." onkeyup="filterPatterns(this.value)" style="width:100%;padding:8px;margin:5px 0;border:1px solid #e94560;border-radius:5px;background:#0f0f23;color:#fff;">
            <div class="pattern-checkboxes" id="patternCheckboxes"></div>
        </div>
    </div>
</div>

<div class="tile-count warning" id="tileCount">手牌: 0 | 公開牌: 0</div>

<div class="display-section">
    <div class="label active" id="openLabel">🔓 公開牌</div>
    <div class="tile-display" id="openDisplay"></div>
</div>

<div class="display-section">
    <div class="label" id="handLabel">🧱 手牌</div>
    <div class="tile-display" id="handDisplay"></div>
</div>

<div class="code-input">
    <input type="text" id="codeInput" placeholder="例如: 1112223334567m 或 111m222m333m456m7m">
    <div class="hint">百搭: 1j=皇 2j=合 3j=萬 4j=筒 5j=索 6j=風 7j=番 8j=三元</div>
    <div class="btn-row">
        <button onclick="loadFromCode()">📥 載入代碼</button>
        <button onclick="generateWinningHand()" class="btn-gen">🎲 生成17張胡牌</button>
        <button onclick="calculate()" class="btn-calc">🔍 計算聽牌</button>
        <button onclick="clearAll()" class="btn-clear">🗑️ 清除</button>
        <label class="zimo-toggle" style="cursor:pointer;">
            <input type="checkbox" id="zimoToggle"> 
            <span class="toggle-slider"></span>
            <span class="toggle-text">自摸</span>
        </label>
        <button onclick="savePatternExample()" class="btn-save" id="saveBtn" style="display:none;">✅ 確認輸入牌型</button>
    </div>
</div>

<p class="tip">提示：點擊上方「公開牌」或「手牌」可切換輸入模式</p>

<div class="tile-section"><h3>🀇 萬子</h3><div class="tile-grid" id="wanTiles"></div></div>
<div class="tile-section"><h3>🀐 索子</h3><div class="tile-grid" id="tiaoTiles"></div></div>
<div class="tile-section"><h3>🀙 筒子</h3><div class="tile-grid" id="tongTiles"></div></div>
<div class="tile-section"><h3>🀀 字牌</h3><div class="tile-grid" id="ziTiles"></div></div>
<div class="tile-section"><h3>🀢 花牌</h3><div class="tile-grid" id="flowerTiles"></div></div>
<div class="tile-section"><h3>🃏 百搭</h3><div class="tile-grid" id="wildTiles"></div></div>

<div class="result-section" id="resultSection">
    <div class="result-box">
        <div class="shanten" id="shantenResult"></div>
        <div class="waiting-grid" id="waitingGrid"></div>
    </div>
</div>

<!-- Custom Modal -->
<div class="modal" id="modal">
    <div class="modal-content">
        <span class="modal-close" onclick="closeModal()">&times;</span>
        <div id="modalBody"></div>
    </div>
</div>

<script>
const TILES = {{ tiles_json | tojson | safe }};
const FLOWER_TILES = {{ flower_json | tojson | safe }};
const WILDCARDS = {{ wildcards_json | tojson | safe }};

// State
let gameMode = 16;
let openTiles = [];
let handTiles = [];
let inputMode = 'open';

// Initialize
function init() {
    renderButtons();
    bindEvents();
    setInputMode('open');
}

// Bind events
function bindEvents() {
    document.getElementById('openDisplay').addEventListener('click', () => setInputMode('open'));
    document.getElementById('handDisplay').addEventListener('click', () => setInputMode('hand'));
    document.querySelectorAll('.mode-btn').forEach(btn => {
        btn.addEventListener('click', (e) => setMode(parseInt(e.target.dataset.mode)));
    });
}

// Render tile buttons
function renderButtons() {
    const suits = [
        { id: 'wanTiles', key: 'wan', tiles: ['1m','2m','3m','4m','5m','6m','7m','8m','9m'] },
        { id: 'tiaoTiles', key: 'tiao', tiles: ['1s','2s','3s','4s','5s','6s','7s','8s','9s'] },
        { id: 'tongTiles', key: 'tong', tiles: ['1p','2p','3p','4p','5p','6p','7p','8p','9p'] },
        { id: 'ziTiles', key: 'zi', tiles: ['1z','2z','3z','4z','5z','6z','7z'] },
    ];

    suits.forEach(s => {
        const container = document.getElementById(s.id);
        s.tiles.forEach(tile => {
            const btn = document.createElement('button');
            btn.className = 'tile-btn ' + s.key;
            btn.textContent = TILES[tile]?.unicode || '?';
            btn.onclick = () => addTile(tile);
            container.appendChild(btn);
        });
    });

    // Flower tiles
    const flowerContainer = document.getElementById('flowerTiles');
    Object.keys(FLOWER_TILES).forEach(tile => {
        const btn = document.createElement('button');
        btn.className = 'tile-btn flower';
        btn.textContent = FLOWER_TILES[tile].unicode;
        btn.onclick = () => addTile(tile);
        flowerContainer.appendChild(btn);
    });

    // Wildcards
    const wildContainer = document.getElementById('wildTiles');
    Object.keys(WILDCARDS).forEach(key => {
        const w = WILDCARDS[key];
        const btn = document.createElement('button');
        btn.className = 'tile-btn wild';
        btn.textContent = w.unicode;
        btn.title = w.name + ': ' + w.替代;
        btn.onclick = () => addTile(w.code);
        wildContainer.appendChild(btn);
    });
}

// Add tile
function addTile(tile) {
    const arr = inputMode === 'open' ? openTiles : handTiles;
    const counts = {};
    arr.forEach(t => counts[t] = (counts[t] || 0) + 1);

    if ((counts[tile] || 0) >= 4) {
        showModal('每張牌最多4張！');
        return;
    }

    if (inputMode === 'open') {
        if (openTiles.length >= 16) {
            showModal('公開牌最多16張！');
            return;
        }
        openTiles.push(tile);
    } else {
        if (handTiles.length >= 17) {
            showModal('手牌最多17張！');
            return;
        }
        handTiles.push(tile);
    }
    updateDisplay();
}

// Remove tile
function removeTile(arr, index) {
    arr.splice(index, 1);
    updateDisplay();
}

// Update display
function updateDisplay() {
    document.getElementById('tileCount').textContent = '手牌: ' + handTiles.length + ' | 公開牌: ' + openTiles.length;

    const od = document.getElementById('openDisplay');
    od.innerHTML = '';
    openTiles.forEach((t, i) => {
        const d = createTileDiv(t);
        d.onclick = () => removeTile(openTiles, i);
        od.appendChild(d);
    });

    const hd = document.getElementById('handDisplay');
    hd.innerHTML = '';
    handTiles.forEach((t, i) => {
        const d = createTileDiv(t);
        d.onclick = () => removeTile(handTiles, i);
        hd.appendChild(d);
    });
}

// Create tile div
function createTileDiv(tile) {
    const d = document.createElement('div');
    let c = 'tile ';
    if (TILES[tile]) c += TILES[tile].suit;
    else if (FLOWER_TILES[tile]) c += FLOWER_TILES[tile].suit;
    else if (tile.endsWith('j')) c += 'wild';
    d.className = c;
    
    // Get display text
    let text = tile;
    if (TILES[tile]) text = TILES[tile].unicode;
    else if (FLOWER_TILES[tile]) text = FLOWER_TILES[tile].unicode;
    else if (tile.endsWith('j')) {
        // Map code to name (matching backend code)
        const map = {'1j':'🃏皇','2j':'合','3j':'萬','4j':'筒','5j':'索','6j':'風','7j':'番','8j':'三元'};
        text = map[tile] || tile;
    }
    
    d.innerHTML = text + '<span class="remove">×</span>';
    return d;
}

// Set input mode
function setInputMode(mode) {
    inputMode = mode;
    document.getElementById('openLabel').classList.toggle('active', mode === 'open');
    document.getElementById('handLabel').classList.toggle('active', mode === 'hand');
    document.getElementById('openDisplay').classList.toggle('active', mode === 'open');
    document.getElementById('handDisplay').classList.toggle('active', mode === 'hand');
}

// Set game mode
function setMode(mode) {
    gameMode = mode;
    document.querySelectorAll('.mode-btn').forEach(btn => {
        btn.classList.toggle('active', parseInt(btn.dataset.mode) === mode);
    });
}

// Load from code
function loadFromCode() {
    const code = document.getElementById('codeInput').value.trim();
    if (!code) { showModal('請輸入牌代碼'); return; }

    handTiles = [];
    openTiles = [];

    const tokens = code.match(/[0-9]+[mpsznj]/g) || [];
    tokens.forEach(token => {
        const num = token.slice(0, -1);
        const suit = token.slice(-1);
        const actualSuit = suit === 'j' ? 'z' : suit;
        for (let i = 0; i < num.length; i++) {
            const tile = num[i] + actualSuit;
            if (TILES[tile]) handTiles.push(tile);
        }
    });

    updateDisplay();
    calculate();
}

// Generate winning hand
// Generate winning hand - use backend API for 100% success
function generateWinningHand() {
    fetch('/generate')
        .then(r => r.json())
        .then(data => {
            if (data.hand) {
                handTiles = data.hand;
                openTiles = [];
                
                // Also display the tile codes in the input field (debug mode only)
                if (false) {
                    const allTilesStr = handTiles.join(' ');
                    document.getElementById('codeInput').value = allTilesStr;
                }
                
                updateDisplay();
                // Trigger calculation and update detected patterns
                if (false) {
                    calculate();
                } else {
                    setTimeout(calculate, 100);
                }
            } else {
                showModal('生成失敗，請再試');
            }
        })
        .catch(e => {
            showModal('Error: ' + e.message);
        });
}

function idxToTile(idx) {
    if (idx === undefined || idx === null || isNaN(idx) || idx < 0 || idx >= 34) return '';
    const suits = ['m', 's', 'p'];
    const suit = Math.floor(idx / 9);
    const num = idx % 9;
    return (num + 1) + suits[suit];
}

// Calculate
function calculate() {
    if (handTiles.length === 0) {
        alert('請先選擇手牌！');
        return;
    }
    fetch('/calc', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ hand: handTiles, open: openTiles, mode: gameMode })
    }).then(r => r.json()).then(showResult);
}

// Show result
function showResult(d) {
    const s = document.getElementById('resultSection');
    s.classList.add('show');

    let shantenText = '';
    let shantenClass = '';

    if (d.shanten === -1) {
        const totalFan = d.winning_fan || 0;
        const breakdown = d.winning_breakdown || [];
        shantenText = '🀄 已胡牌！總番數: ' + totalFan + ' 番';
        shantenClass = ' tenpai';

        if (breakdown.length > 0) {
            // Group patterns by fan count (high to low)
            const sorted = [...breakdown].sort((a, b) => b.fan - a.fan);
            const bdHtml = sorted.map(b => 
                '<span class="fan-tag">' + b.name + '<span class="fan-num">' + b.fan + '</span></span>'
            ).join('');
            document.getElementById('waitingGrid').innerHTML = '<div class="fan-list">' + bdHtml + '</div>';
        }
    } else if (d.shanten === 0) {
        shantenText = '🎉 已聽牌!';
        shantenClass = ' tenpai';
    } else if (d.shanten > 0) {
        shantenText = '向聽數: ' + d.shanten;
    } else {
        shantenText = '❌ 未能聽牌';
    }

    document.getElementById('shantenResult').textContent = shantenText;
    document.getElementById('shantenResult').className = 'shanten' + shantenClass;

    const g = document.getElementById('waitingGrid');
    if (d.shanten === -1) {
        // Winning - breakdown shown above
    } else if (d.waiting.length === 0) {
        g.innerHTML = '<div style="color:#aaa;font-size:14px">暫無聽牌</div>';
    } else {
        const suits = { 'wan': [], 'tiao': [], 'tong': [], 'zi': [] };
        d.waiting.forEach(w => {
            const t = w.tile;
            if (t.endsWith('m')) suits.wan.push(w);
            else if (t.endsWith('s')) suits.tiao.push(w);
            else if (t.endsWith('p')) suits.tong.push(w);
            else suits.zi.push(w);
        });

        let html = '';
        Object.keys(suits).forEach(suit => {
            if (suits[suit].length === 0) return;
            html += '<div style="display:flex;gap:6px;justify-content:center;margin:5px 0;flex-wrap:wrap;">';
            suits[suit].forEach(w => {
                html += '<div class="waiting-item ' + suit + '" onclick="showBreakdown(\'' + w.tile + '\', \'' + w.unicode + '\', ' + JSON.stringify(w.breakdown).replace(/"/g, '&quot;') + ', ' + w.fan + ')">';
                html += '<span class="tc">' + w.unicode + '</span>';
                html += '<span class="fan">' + w.fan + '番</span>';
                html += '</div>';
            });
            html += '</div>';
        });
        g.innerHTML = html;
    }

    s.scrollIntoView({ behavior: 'smooth' });
}

function showBreakdown(tile, unicode, breakdown, fan) {
    if (breakdown && breakdown.length > 0) {
        const msg = breakdown.map(b => b.name + ': ' + b.fan + '番').join('\n');
        showModal('胡 ' + unicode + ' 的牌型:\n' + msg + '\n\n總番數: ' + fan + '番');
    } else {
        showModal('胡 ' + unicode + ': ' + fan + '番');
    }
}

function showModal(content) {
    document.getElementById('modalBody').innerHTML = content.replace(/\n/g, '<br>');
    document.getElementById('modal').classList.add('show');
}

function closeModal() {
    document.getElementById('modal').classList.remove('show');
}

function clearAll() {
    openTiles = [];
    handTiles = [];
    document.getElementById('resultSection').classList.remove('show');
    updateDisplay();
}

// ========== Debug Mode with Checkboxes ==========
// false removed
let currentDetectedPatterns = [];


const PATTERN_CATEGORIES = {
    // 花字類 (庭芳)
    "花字類": ["一台花", "有花", "正花", "無花", "風牌", "無字", "正圈風牌", "正位風牌", "三元牌", "無字花", "花上自摸"],
    
    // 叮牌類
    "叮牌類": ["叮牌", "即食", "天聽", "地聽"],
    
    // 拉莊類
    "拉莊類": ["莊", "連莊"],
    
    // 胡牌型式類
    "胡牌型式類": ["假獨", "對碰", "獨獨"],
    
    // 平胡類
    "平胡類": ["平胡", "無字花平胡", "自摸", "花上自摸", "槓上自摸"],
    
    // 最後糊牌類
    "最後糊牌類": ["海底撈月", "河底撈魚"],
    
    // 一炮多響類
    "一炮多響類": ["雙響", "三響"],
    
    // 缺類
    "缺類": ["斷幺", "無字缺五", "缺一門"],
    
    // 門齊類
    "門齊類": ["小五門齊", "大五門齊", "小七門齊", "大七門齊"],
    
    // 同順類
    "同順類": ["姊妹", "般高", "三相逢"],
    
    // 步高類
    "步高類": ["三色步步高(明)", "三色步步高(暗)", "一色步步高(明)", "一色步步高(暗)",
               "三色二步高(明)", "三色二步高(暗)", "一色二步高(明)", "一色二步高(暗)",
               "三色三步高(明)", "三色三步高(暗)", "一色三步高(明)", "一色三步高(暗)",
               "三色四步高(明)", "三色四步高(暗)", "一色四步高(明)", "一色四步高(暗)",
               "三色五步高(明)", "三色五步高(暗)", "一色五步高(明)", "一色五步高(暗)"],
    
    // 老少類
    "老少類": ["老少", "老少刻"],
    
    // 對對胡
    "對對胡類": ["對對胡"],
    
    // 同刻類
    "同刻類": ["兄弟", "小三兄弟", "大三兄弟"],
    
    // 連刻類
    "連刻類": ["兩連刻", "小三連刻", "三連刻", "小四連刻", "四連刻", "小五連刻", "五連刻"],
    
    // 暗刻類
    "暗刻類": ["兩暗刻", "三暗刻", "四暗刻", "五暗刻", "坎坎胡"],
    
    // 槓類
    "槓類": ["搶槓", "一槓", "二槓", "三槓", "四槓", "五槓"],
    
    // 歸類
    "歸類": ["四歸一(明)", "四歸一(暗)", "四歸二(明)", "四歸二(暗)", "四歸四(明)", "四歸四(暗)"],
    
    // 風牌類
    "風牌類": ["小三風", "大三風", "小四喜", "大四喜"],
    
    // 元牌類
    "元牌類": ["小三元", "大三元"],
    
    // 求人類
    "求人類": ["門清", "不求人", "半求人", "全求人"],
    
    // 速度類
    "速度類": ["天胡", "地胡", "人胡", "四子", "七子", "十子"],
    
    // 嚦咕類
    "嚦咕類": ["嚦咕", "正嚦咕"],
    
    // 十六不搭類
    "十六不搭類": ["十六不搭", "十六不搭十六面聽", "十六不搭三相逢", "正十六不搭"],
    
    // 十三幺類
    "十三幺類": ["十三幺", "十三幺十三面聽"],
    
    // 一色類
    "一色類": ["混一色", "清一色", "綠一色", "字一色"],
    
    // 幺九類
    "幺九類": ["混全帶幺", "清全帶幺", "混幺", "清幺"],
    
    // 其他
    "其他": ["將眼", "絕絕", "二數", "三數", "風字坎", "箭刻", ]
};

function toggleDebugMode() {
    // false removed
    const panel = document.getElementById('debugPanel');
    const btn = document.getElementById('debugBtn');
    const saveBtn = document.getElementById('saveBtn');
    
    if (false) {
        panel.style.display = 'block';
        btn.classList.add('active');
        saveBtn.style.display = 'inline-block';
        populatePatternCheckboxes();
    } else {
        panel.style.display = 'none';
        btn.classList.remove('active');
        saveBtn.style.display = 'none';
    }
}

function populatePatternCheckboxes() {
    const container = document.getElementById('patternCheckboxes');
    container.innerHTML = '';
    
    for (const [category, patterns] of Object.entries(PATTERN_CATEGORIES)) {
        const fieldset = document.createElement('fieldset');
        fieldset.innerHTML = `<legend>${category}</legend>`;
        
        for (const p of patterns) {
            const label = document.createElement('label');
            label.className = 'checkbox-label';
            label.innerHTML = `<input type="checkbox" value="${p}" onchange="onCheckboxChange()"> ${p}`;
            fieldset.appendChild(label);
        }
        container.appendChild(fieldset);
    }
}

// Called when user changes any checkbox
function onCheckboxChange() {
    const checkboxes = document.querySelectorAll('#patternCheckboxes input[type="checkbox"]');
    const selected = [];
    checkboxes.forEach(cb => {
        if (cb.checked) selected.push(cb.value);
    });
    
    renderDisplayedPatterns(selected);
}

// Render patterns to display area
function renderDisplayedPatterns(patterns) {
    const detectedDiv = document.getElementById('detectedPatterns');
    if (patterns.length === 0) {
        detectedDiv.innerHTML = '<span class="no-pattern">無</span>';
    } else {
        detectedDiv.innerHTML = patterns.map(p => 
            `<span class="detected-tag" title="點擊移除" onclick="removePatternByName('${p}')">${p} ×</span>`
        ).join(' ');
    }
}

function removePatternByName(name) {
    const checkboxes = document.querySelectorAll('#patternCheckboxes input[type="checkbox"]');
    checkboxes.forEach(cb => {
        if (cb.value === name) cb.checked = false;
    });
    onCheckboxChange();
}

function filterPatterns(searchTerm) {
    const labels = document.querySelectorAll('#patternCheckboxes label');
    labels.forEach(label => {
        const text = label.textContent.toLowerCase();
        label.style.display = text.includes(searchTerm.toLowerCase()) ? "inline-block" : "none";
    });
}

// Update from server calculation
function updateDetectedPatterns(patterns) {
    const checkboxes = document.querySelectorAll('#patternCheckboxes input[type="checkbox"]');
    checkboxes.forEach(cb => {
        cb.checked = patterns.includes(cb.value);
    });
    onCheckboxChange();
}

function savePatternExample() {
    const allTiles = [...openTiles, ...handTiles];
    if (allTiles.length < 14) { alert('請輸入至少14張牌！'); return; }
    
    // Get currently checked patterns
    const checkboxes = document.querySelectorAll('#patternCheckboxes input[type="checkbox"]:checked');
    const selectedPatterns = Array.from(checkboxes).map(cb => cb.value);
    
    if (selectedPatterns.length === 0) { alert('請至少選擇一個牌型！'); return; }
    
    // Get self-draw status
    const isZimo = document.getElementById('zimoToggle').checked;
    
    // If self-draw, add "自摸" to patterns
    let patternsToSave = [...selectedPatterns];
    if (isZimo && !patternsToSave.includes('自摸')) {
        patternsToSave.push('自摸');
    }
    
    let saved = 0;
    patternsToSave.forEach(pattern => {
        fetch('/save_example', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                pattern: pattern, 
                open_tiles: openTiles,
                hand_tiles: handTiles,
                is_zimo: isZimo
            })
        }).then(r => r.json()).then(data => {
            saved++;
            if (saved === patternsToSave.length) alert(`已儲存 ${saved} 個牌型案例！`);
        });
    });
}

const originalCalculate = calculate;
calculate = function() {
    originalCalculate();
    if (false) {
        const allTiles = [...openTiles, ...handTiles];
        fetch('/calc', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({hand: allTiles, open: [], mode: 16})})
        .then(r => r.json()).then(result => {
            if (result.shanten === -1) updateDetectedPatterns(result.winning_breakdown.map(p => p.name));
            else updateDetectedPatterns([]);
        });
    }
};

init();
</script>
</body>
</html>
