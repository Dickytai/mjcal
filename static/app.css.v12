* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

body {
    font-family: "Microsoft JhengHei", "PingFang TC", sans-serif;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: #fff;
    margin: 0;
    padding: 10px;
    padding-bottom: 120px;
    min-height: 100vh;
}

h1 {
    text-align: center;
    color: #ffd700;
    margin: 10px 0;
    font-size: 1.4em;
}

/* Mode Buttons */
.mode-select {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin: 10px 0;
}

.mode-btn {
    padding: 12px 24px;
    border: 2px solid #00f5d4;
    background: transparent;
    color: #00f5d4;
    border-radius: 25px;
    cursor: pointer;
    font-size: 16px;
    font-weight: bold;
    transition: all 0.3s ease;
}

.mode-btn.active {
    background: linear-gradient(135deg, #00f5d4, #00b894);
    color: #1a1a2e;
}

/* Tile Count */
.tile-count {
    text-align: center;
    padding: 12px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: bold;
    margin: 10px 0;
}

.tile-count.ok {
    background: linear-gradient(135deg, #00f5d4, #00b894);
    color: #1a1a2e;
}

.tile-count.warning {
    background: linear-gradient(135deg, #ffd700, #f39c12);
    color: #1a1a2e;
}

/* Display Sections */
.display-section { margin: 10px 0; }

.display-section .label {
    color: #aaa;
    font-size: 12px;
    margin-bottom: 6px;
    cursor: pointer;
}

.display-section .label.active { color: #00f5d4; font-weight: bold; }

.tile-display {
    min-height: 55px;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 12px;
    padding: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    cursor: pointer;
}

.tile-display.active { border: 3px solid #00f5d4; background: rgba(0, 245, 212, 0.1); }

/* Tiles */
.tile {
    width: 38px;
    height: 52px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    cursor: pointer;
    position: relative;
    transition: transform 0.1s;
}

.tile:active { transform: scale(0.95); }

.tile.wan { background: linear-gradient(180deg, #ffeaa7, #fdcb6e); color: #8b0000; }
.tile.tiao { background: linear-gradient(180deg, #d4efdf, #27ae60); color: #1e5631; }
.tile.tong { background: linear-gradient(180deg, #a29bfe, #6c5ce7); color: #fff; }
.tile.zi { background: linear-gradient(180deg, #ff7675, #d63031); color: #fff; }
.tile.wild { background: linear-gradient(180deg, #ff6b6b, #c0392b); color: #fff; font-size: 14px; }
.tile.flower, .tile.season { background: linear-gradient(180deg, #81ecec, #00cec9); color: #fff; }

.tile .remove {
    position: absolute;
    top: -5px;
    right: -5px;
    width: 16px;
    height: 16px;
    background: #e74c3c;
    color: #fff;
    border-radius: 50%;
    font-size: 12px;
    display: none;
    align-items: center;
    justify-content: center;
}

.tile:hover .remove { display: flex; }

/* Tile Sections */
.tile-section { margin: 8px 0; }
.tile-section h3 { color: #4ecdc4; margin: 8px 0; font-size: 13px; }

.tile-grid { display: flex; flex-wrap: wrap; gap: 4px; }

.tile-btn {
    width: 36px;
    height: 48px;
    border: none;
    border-radius: 6px;
    font-size: 22px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.1s;
}

.tile-btn:active { transform: scale(0.9); }

.tile-btn.wan { background: linear-gradient(180deg, #ffeaa7, #fdcb6e); color: #8b0000; }
.tile-btn.tiao { background: linear-gradient(180deg, #d4efdf, #27ae60); color: #1e5631; }
.tile-btn.tong { background: linear-gradient(180deg, #a29bfe, #6c5ce7); color: #fff; }
.tile-btn.zi { background: linear-gradient(180deg, #ff7675, #d63031); color: #fff; }
.tile-btn.wild { background: linear-gradient(180deg, #ff6b6b, #c0392b); color: #fff; font-size: 14px; }
.tile-btn.flower, .tile-btn.season { background: linear-gradient(180deg, #81ecec, #00cec9); color: #fff; }

/* Buttons */
.btn-calculate {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 25px;
    background: linear-gradient(135deg, #00f5d4, #00b894);
    color: #1a1a2e;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    margin: 12px 0;
    transition: transform 0.1s;
}

.btn-calculate:active { transform: scale(0.98); }

.btn-clear {
    width: 100%;
    padding: 10px;
    border: 2px solid #ff7675;
    background: transparent;
    color: #ff7675;
    border-radius: 20px;
    cursor: pointer;
    font-size: 14px;
    margin-bottom: 10px;
}

/* Code Input */
.code-input { margin: 10px 0; }

.code-input input {
    width: 100%;
    padding: 10px;
    border: 2px solid #4ecdc4;
    background: rgba(0,0,0,0.4);
    color: #fff;
    border-radius: 10px;
    font-size: 14px;
    font-family: monospace;
}

.code-input .hint { color: #666; font-size: 11px; margin-top: 5px; }

.code-input button {
    margin-top: 8px;
    padding: 8px 16px;
    border: none;
    border-radius: 15px;
    background: #4ecdc4;
    color: #1a1a2e;
    font-size: 12px;
    cursor: pointer;
}

.code-input button.btn-gen { background: #ff6b6b; }

.btn-row { display: flex; gap: 10px; margin-top: 8px; }

/* Result Section */
.result-section { display: none; margin: 15px 0; background: rgba(0,0,0,0.4); border-radius: 15px; padding: 15px; }
.result-section.show { display: block; }

.result-box { background: rgba(0, 0, 0, 0.5); border-radius: 15px; padding: 15px; }

.shanten {
    font-size: 32px;
    color: #fff;
    text-align: center;
    margin: 10px 0;
    font-weight: bold;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
}

.shanten.tenpai { color: #00ff00; text-shadow: 0 0 10px #00ff00; }

.waiting-grid { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin: 12px 0; }

.waiting-item {
    width: 38px;
    height: 52px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    cursor: pointer;
}

.waiting-item.wan { background: linear-gradient(180deg, #f39c12, #d68910); }
.waiting-item.tiao { background: linear-gradient(180deg, #27ae60, #1e8449); }
.waiting-item.tong { background: linear-gradient(180deg, #8e44ad, #6c3483); }
.waiting-item.zi { background: linear-gradient(180deg, #c0392b, #922b21); }
.waiting-item.best { border: 2px solid #ffd700; }

.waiting-item .tc { font-size: 22px; }
.waiting-item .fan { font-size: 9px; color: #fff; background: rgba(0,0,0,0.6); padding: 1px 4px; border-radius: 6px; margin-top: 1px; }
.waiting-item .cnt { position: absolute; top: -5px; right: -5px; font-size: 10px; background: #e74c3c; color: #fff; padding: 2px 5px; border-radius: 8px; }

.suggestion {
    background: rgba(0,0,0,0.3);
    border-left: 3px solid #00ff00;
    padding: 10px;
    border-radius: 0 10px 10px 0;
    font-size: 11px;
    margin-top: 10px;
    color: #fff;
    word-break: break-all;
}

.tip { color: #666; font-size: 11px; text-align: center; margin: 8px 0; }

/* Modal */
.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.8);
    z-index: 1000;
    align-items: center;
    justify-content: center;
}

.modal.show { display: flex; }

.modal-content {
    background: #1a1a2e;
    border: 2px solid #00f5d4;
    border-radius: 15px;
    padding: 20px;
    max-width: 90%;
    max-height: 80%;
    overflow: auto;
    position: relative;
}

.modal-close {
    position: absolute;
    top: 10px;
    right: 15px;
    font-size: 24px;
    color: #ff7675;
    cursor: pointer;
}

.modal-body { color: #fff; white-space: pre-wrap; }

/* Fan tags for winning hand */
.fan-list { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 10px 0; }
.fan-tag { 
    background: linear-gradient(135deg, #667eea, #764ba2); 
    padding: 6px 12px; 
    border-radius: 20px; 
    font-size: 14px;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 6px;
}
.fan-tag .fan-num { 
    background: rgba(0,0,0,0.3); 
    padding: 2px 8px; 
    border-radius: 10px; 
    font-weight: bold;
    color: #ffd700;
}

/* Debug Mode */
.debug-panel {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    border: 2px solid #e94560;
    border-radius: 12px;
    padding: 15px;
    margin: 10px 0;
    color: #fff;
}

.debug-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.debug-header h3 {
    margin: 0;
    color: #e94560;
}

.debug-header button {
    background: #e94560;
    color: white;
    border: none;
    padding: 5px 15px;
    border-radius: 5px;
    cursor: pointer;
}

.debug-content label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
}

.debug-content select {
    width: 100%;
    padding: 10px;
    border-radius: 5px;
    border: 1px solid #e94560;
    background: #0f0f23;
    color: #fff;
    font-size: 16px;
    margin-bottom: 10px;
}

.pattern-stats {
    background: #0f0f23;
    padding: 10px;
    border-radius: 5px;
    margin: 10px 0;
    text-align: center;
    color: #00ff88;
}

.debug-result {
    padding: 15px;
    border-radius: 5px;
    margin-top: 10px;
    text-align: center;
    background: #0f0f23;
    min-height: 40px;
}

.debug-result:empty {
    display: none;
}

.mode-btn.active {
    background: #e94560 !important;
}

.btn-save {
    background: #28a745 !important;
    color: white !important;
    border: none !important;
    padding: 10px 15px !important;
    border-radius: 5px !important;
    cursor: pointer !important;
    font-size: 14px !important;
}

/* Debug Checkbox Styles */
.debug-section {
    margin: 10px 0;
    padding: 10px;
    background: #0f0f23;
    border-radius: 5px;
}

.detected-patterns {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    padding: 10px;
    background: #1a1a3e;
    border-radius: 5px;
    min-height: 30px;
}

.detected-tag {
    background: #4a90d9;
    color: white;
    padding: 3px 8px;
    border-radius: 3px;
    font-size: 12px;
}

.no-pattern {
    color: #666;
    font-style: italic;
}

.pattern-checkboxes {
    max-height: 300px;
    overflow-y: auto;
}

.pattern-checkboxes fieldset {
    border: 1px solid #e94560;
    margin: 5px 0;
    padding: 5px;
    border-radius: 5px;
}

.pattern-checkboxes legend {
    color: #e94560;
    font-weight: bold;
    padding: 0 5px;
}

.checkbox-label {
    display: inline-block;
    margin: 3px 8px 3px 0;
    color: #ccc;
    font-size: 13px;
    cursor: pointer;
}

.checkbox-label input {
    margin-right: 5px;
}

/* Button Row - Consistent Style */
.btn-row button {
    flex: 1;
    padding: 10px 8px;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-row button:active { transform: scale(0.96); }

.btn-row button:first-child { background: #74b9ff; color: #1a1a2e; }
.btn-row button:nth-child(2) { background: #ff7675; color: #fff; }
.btn-row button:nth-child(3) { background: #00b894; color: #fff; }
.btn-row button:nth-child(4) { background: #636e72; color: #fff; }
.btn-row button:nth-child(5) { background: #28a745; color: #fff; }

.btn-row button:hover { filter: brightness(1.1); }
